---
// About — migrated verbatim from Dave's Jul 29 2026 handoff, rev 4:
// handoff/2026-07-29-dave-pages/1_ABOUT/about-deploy-rev4/about.html
// (reconstructed from the de-inlined build/ sources — build_about.py + t_*.css +
// about_addendum.css — per CLAUDE-HANDOFF.md §6, rather than decoding the
// self-contained file's base64 images by hand).
// See docs/planning/TECHNICAL-ARCHITECTURE.md §3 — no redesign, structure/CSS copied as-is.
// Shared <Nav />/<Footer /> replace this page's own header/footer markup (deleted per
// migration hard rules); nav/footer seams are wired centrally in src/config/seams.ts.
//
// Photos extracted to /public/assets from
// handoff/.../about-deploy-rev4/photos/ — hero kept as about-hero-team-bali-july2025.jpg;
// story photos + 24 headshots use ab- prefixes keyed by slug. Nothing left inline as base64.
import BaseLayout from '../layouts/BaseLayout.astro';
import { seams } from '../config/seams';

const shareSubject = 'Thought of you. This is what teacher wellbeing looks like.';
const shareBody = "Met an organization I think you'd like. Start here: https://www.contentment.org";
const shareMailto = `mailto:?subject=${encodeURIComponent(shareSubject)}&body=${encodeURIComponent(shareBody)}`;

const TEAM = [
  ['Navin Amarasuriya', 'Chief Executive Officer', 'navin-amarasuriya'],
  ['Lorna Holman', 'Chief Financial Officer', 'lorna-holman'],
  ['Dave Kebo', 'Chief Media Officer', 'dave-kebo'],
  ['Jennifer Jones', 'Chief Implementation Officer', 'jennifer-jones'],
  ['WoeiJing Teng', 'Mission Advancement + Community Building', 'woeijing-teng'],
  ['Somesh Bhardwaj', 'Senior System Administrator', 'somesh-bhardwaj'],
  ['Kristina Blundon', 'Director of Operations', 'kristina-blundon'],
  ['Pamila Nigah', 'Finance Director', 'pamila-nigah'],
  ['Tim Huang', 'Director, Global Implementation', 'tim-huang'],
  ['Tshering Eudon', 'Director, Asia', 'tshering-eudon'],
  ['Karma Doma Tshering', 'Director, Bhutan', 'karma-doma-tshering'],
  ['Tempa Ragbay', 'Associate Director, Bhutan', 'tempa-ragbay'],
  ['Susan Gathu', 'Senior Program Lead, Africa', 'susan-gathu'],
  ['Jennifer Gonsalves', 'Outreach & Implementation Specialist, Hawaiʻi', 'jennifer-gonsalves'],
  ['Anik Ghosh', 'Senior Software Engineer', 'anik-ghosh'],
  ['Ryan Miller', 'Internal Culture Associate', 'ryan-miller'],
  ['Cikara Ni Luh', 'Community Engagement Coordinator', 'cikara-ni-luh'],
];
const BOARD = [
  ['Emmet B. Keeffe III', 'Chairman & Co-Founder of The Contentment Foundation', 'board-emmet-keeffe'],
  ['Heidi Roddenberry', 'President at The Roddenberry Foundation', 'board-heidi-roddenberry'],
  ['Yossri Abdou, J.D.', 'Founder & Partner at Libertas Law', 'board-yossri-abdou'],
  ['David Simas, J.D.', 'Managing Director of Research, Emerson Collective', 'board-david-simas'],
];
const ADVISORY = [
  ['Yikai Xu', 'Scientific Advisor (New York University)', 'adv-yikai-xu'],
  ['Robin Graat', 'Events Strategy Advisor', 'adv-robin-graat'],
  ['Lakhan Samani', 'Tech Advisor', 'adv-lakhan-samani'],
];
---
<BaseLayout
  title="About The Contentment Foundation"
  description="Since 2016, TCF has reached 11,925 educators and 409,625+ students across 12 countries with scientifically evidenced teacher wellbeing practices."
>

<!-- 1 HERO -->
<section class="about-hero" id="top">
  <div class="about-hero-bg" role="img" aria-label="The Contentment Foundation team, arms raised, on a Bali hilltop at dusk" style="background-image:url('/assets/about-hero-team-bali-july2025.jpg');background-position:50% 26%"></div>
  <div class="about-hero-scrim" aria-hidden="true"></div>
  <div class="wrap about-hero-inner">
    <h1>We're the people<br>who look after the people<br>who look after&nbsp;kids.</h1>
    <p class="hero-sub">For ten years, in twelve countries, we've had one job: tend to the wellbeing of teachers so that every student walks into a room and can truly be seen, heard and supported.</p>
    <a class="skiplink" href="#team">Skip to meet the team &darr;</a>
  </div>
  <span class="hero-caption">Most of us, Bali, July 2025</span>
</section>

<!-- 2 OUR STORY -->
<section class="band story">
  <div class="story-grid">
    <div class="story-txt">
      <span class="eyebrow anim">Where this started</span>
      <h2 class="title anim d1">Before this was an organization, there was a scientist with a curiosity he couldn't shake.</h2>
      <p class="body anim d2">Dr. Daniel Cordaro spent years tracing emotions across cultures, from research labs to the mountains of Eastern Bhutan. Along the way, an insight came into focus: Contentment. The quiet perception that this moment is truly enough, complete in itself, with nothing really missing.</p>
      <p class="body anim d3">Ten years on, this work of wellbeing has grown as a labour of love, co-created by a principal who opened a door with fierce love, teachers who made room in already-full days, families who offered trust, and donors, volunteers, and countless others&hellip;</p>
      <p class="body anim d3">And inside schools, a deeper question was revealed: so much is built for students. Who cares for the people who care for them?</p>
      <a class="textlink anim d4" href="/why">Our answer lives here &rarr;</a>
    </div>
    <div class="story-photos">
      <figure class="sphoto live anim"><img src="/assets/ab-dan-bhutan-2014.jpg" alt="Dan Cordaro holding a globe for a circle of schoolchildren outside a school in Eastern Bhutan"><figcaption>Dan in Bhutan, 2014</figcaption></figure>
      <figure class="sphoto live anim d1"><img src="/assets/ab-story-country3.jpg" alt="A teacher and her young students standing together with hands on their hearts in a classroom"><figcaption>Hands on hearts. The Country School, Los Angeles, May 2025</figcaption></figure>
    </div>
  </div>
</section>

<!-- 3 WHAT WE BELIEVE - full-bleed halves, cursive labels, columns hug the seam (Dave 2026-07-20) -->
<section class="believe">
  <div class="believe-halves">
    <div class="bhalf bh-vision">
      <div class="bhalf-inner anim">
        <span class="blabel">Vision</span>
        <p class="bstatement">A world where thriving teachers nurture wiser &amp; kinder generations.</p>
      </div>
    </div>
    <div class="bhalf bh-mission">
      <div class="bhalf-inner anim d1">
        <span class="blabel">Mission</span>
        <p class="bstatement bsm">We empower teachers to cultivate wellbeing in themselves and their classrooms. Our scientifically evidenced work is rooted in cultivating mindfulness, community, self-curiosity, and contentment. When teachers thrive, their ripples reach every corner of the world their students will one day shape.</p>
        <p class="humility anim d2">We're not there yet. Twelve countries in, we've mostly learned how much further there is to go, and that it's worth going.</p>
      </div>
    </div>
  </div>
</section>

<!-- 4 THE TEAM -->
<section class="band team" id="team">
  <div class="wrap">
    <span class="eyebrow anim">Our Team</span>
    <h2 class="title anim d1">A small, remote team.</h2>
    <p class="body anim d2">All of us are people who've either taught, been raised by a teacher, or been saved by one.</p>
    <div class="tgrid">
      {TEAM.map(([name, title, slug]) => (
        <figure class="tcard anim">
          <span class="pface"><img src={`/assets/ab-headshots-${slug}.jpg`} alt={name} /></span>
          <figcaption><strong>{name}</strong><span>{title}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<!-- 5 CONVERSION BAND -->
<section class="band convert">
  <div class="wrap">
    <h2 class="title anim">You don't have to donate to matter here.</h2>
    <div class="cgrid">
      <div class="ccard c-green anim d1">
        <h3>Get the Newsletter</h3>
        <p>Join thousands of supporters building a more compassionate and calm world. One-ish email a month, usually about a teacher, a tool or resource you can try and experiences you can join.</p>
        <!-- FEAT-070 (Flodesk integration) not wired yet — placeholder submit, matches Home's NewsletterForm. -->
        <form onsubmit="return false" data-embed="newsletter">
          <input type="text" placeholder="First name" aria-label="First name">
          <input type="email" placeholder="Email address" aria-label="Email address">
          <button class="btn cbtn" type="submit">Keep me in the loop</button>
        </form>
      </div>
      <div class="ccard c-blue anim d2">
        <h3>Talk with Us</h3>
        <p>Question about our work, your school, a partnership, anything. Kristina and WoeiJing read every message and reply within the week.</p>
        <div class="ccta">
          <a class="btn cbtn" href="mailto:hello@contentment.org">Email a real person &rarr;</a>
          <a class="cemail" href="mailto:hello@contentment.org">hello@contentment.org</a>
        </div>
      </div>
      <div class="ccard c-sand anim d3">
        <h3>Pass it On</h3>
        <p>The most useful thing you can do in ten seconds is show this to someone who loves a teacher.</p>
        <div class="crow">
          <a class="btn cbtn dark" href={seams.link.instagram || '#'} target="_blank" rel="noopener">Instagram</a>
          <a class="btn cbtn dark" href={seams.link.linkedin || '#'} target="_blank" rel="noopener">LinkedIn</a>
          <a class="btn cbtn dark" href={shareMailto} data-share-email>Email this to someone</a>
        </div>
      </div>
    </div>
  </div>
</section>

<!-- 6 BOARD + ADVISORY -->
<section class="band-tight governance">
  <div class="wrap">
    <span class="eyebrow anim">Board of Directors</span>
    <div class="ggrid anim d1">
      {BOARD.map(([name, title, slug]) => (
        <figure class="gcard anim">
          <span class="pface"><img src={`/assets/ab-headshots-${slug}.jpg`} alt={name} /></span>
          <figcaption><strong>{name}</strong><span>{title}</span></figcaption>
        </figure>
      ))}
    </div>
    <span class="eyebrow anim gov-second">Advisors</span>
    <div class="ggrid g3 anim d1">
      {ADVISORY.map(([name, title, slug]) => (
        <figure class="gcard anim">
          <span class="pface"><img src={`/assets/ab-headshots-${slug}.jpg`} alt={name} /></span>
          <figcaption><strong>{name}</strong><span>{title}</span></figcaption>
        </figure>
      ))}
    </div>
  </div>
</section>

<script>
  // Empty-To mailto:? links often no-op in Chromium; prefer Web Share, else force mailto navigation.
  document.querySelectorAll<HTMLAnchorElement>('[data-share-email]').forEach((el) => {
    el.addEventListener('click', async (e) => {
      const href = el.getAttribute('href') || '';
      const subject = 'Thought of you. This is what teacher wellbeing looks like.';
      const text = "Met an organization I think you'd like. Start here: https://www.contentment.org";
      const url = 'https://www.contentment.org';

      e.preventDefault();

      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title: subject, text, url });
        } catch {
          /* user cancelled share sheet — leave quietly */
        }
        return;
      }

      window.location.href = href;
    });
  });
</script>

</BaseLayout>

<style>
  /* Page-specific CSS only — reset/wrap/eyebrow/buttons/nav/footer/.anim/section-typography
     system are already in src/styles/global.css (verified identical against
     build/t_shared.css and build/t_news.css from the handoff's de-inlined sources).
     t_shared.css (section/.band/.band-tight/h2.title/.lead/p.body/.pull/.anim system/.split)
     is byte-identical to global.css and .split isn't used on this page — omitted entirely.
     t_news.css (.news*) is dead CSS for this page: About's newsletter form lives inside
     a .ccard (conversion band), not a standalone .news band — omitted entirely.
     Everything below comes from the handoff's about_addendum.css (page-specific, no
     selector-name collisions with global.css) with the "photo missing" placeholder rules
     dropped (.ph-hero/.ph-hero-label/.sphoto.ph/.pface.ph and their descendants) since
     every photo this page needs was matched to a real file — see the page's frontmatter
     comment / this migration's report for the mapping. The prefers-reduced-motion block
     is also omitted: it duplicated global.css's existing *,.anim rule verbatim. */

  /* ---------- HERO ---------- */
  .about-hero{position:relative;min-height:clamp(560px,92vh,1000px);display:flex;align-items:flex-end;overflow:hidden;background:var(--deep2)}
  .about-hero-bg{position:absolute;inset:0;background-size:cover;background-position:center}
  .about-hero-scrim{position:absolute;inset:0;background:linear-gradient(180deg,rgba(0,144,190,.55) 0%,rgba(0,144,190,0) 20%),linear-gradient(75deg,rgba(0,144,190,.55) 0%,rgba(0,144,190,.15) 48%,rgba(0,144,190,0) 68%),linear-gradient(180deg,rgba(0,144,190,.22) 0%,rgba(0,144,190,.06) 45%,rgba(0,144,190,.9) 100%)}
  .about-hero-inner{position:relative;z-index:2;padding-top:150px;padding-bottom:64px;color:#fff}
  .about-hero h1{text-shadow:0 2px 26px rgba(2,40,58,.6),0 1px 3px rgba(2,40,58,.4);font-family:var(--display);font-weight:500;font-size:clamp(2.2rem,5vw,4rem);line-height:1.06;letter-spacing:-.01em;text-wrap:balance;max-width:20ch}
  .hero-sub{text-shadow:0 1px 18px rgba(2,40,58,.55);margin-top:22px;font-size:clamp(1.05rem,1.5vw,1.3rem);line-height:1.6;max-width:56ch;color:rgba(255,255,255,.92)}
  .skiplink{display:inline-block;margin-top:26px;color:#fff;font-weight:600;border-bottom:2px solid rgba(255,255,255,.6);padding-bottom:2px;transition:border-color .2s}
  .skiplink:hover{border-color:#fff}
  .hero-caption{position:absolute;right:clamp(22px,4vw,56px);bottom:20px;z-index:2;font-family:var(--script);font-size:clamp(1.1rem,1.8vw,1.5rem);color:rgba(255,255,255,.95);transform:rotate(-2deg)}

  /* ---------- OUR STORY (text left, photo rail right) ---------- */
  .story{background:var(--paper)}
  .story-grid{max-width:1240px;margin:0 auto;padding:0 32px;display:grid;grid-template-columns:minmax(0,1.35fr) minmax(300px,1fr);gap:clamp(40px,5vw,84px);align-items:start}
  .story-txt .title{margin:14px 0 26px;font-size:clamp(1.8rem,3.2vw,2.7rem)}
  .story-txt .pull{margin:26px 0}
  .textlink{display:inline-block;margin-top:26px;color:var(--ocean);font-weight:600;border-bottom:2px solid var(--teal);padding-bottom:2px}
  .textlink:hover{color:var(--deep)}
  .story-photos{display:grid;gap:18px;position:sticky;top:96px}
  .sphoto{margin:0}
  .sphoto img{width:100%;border-radius:14px;box-shadow:var(--shadow)}
  .sphoto figcaption{margin-top:8px;font-family:var(--script);font-size:1.05rem;color:var(--slate)}

  /* ---------- WHAT WE BELIEVE (full-bleed halves, seam-hugging) ---------- */
  .believe-halves{display:grid;grid-template-columns:1fr 1fr;min-height:clamp(440px,56vh,640px)}
  .bhalf{display:flex;align-items:flex-start;padding-top:clamp(72px,10vw,136px);padding-bottom:clamp(64px,9vw,120px)}
  .bh-vision{background:var(--green);color:#fff;justify-content:flex-end;padding-left:32px;padding-right:clamp(40px,4.5vw,88px)}
  .bh-mission{background:var(--ocean);color:#fff;justify-content:flex-start;padding-right:32px;padding-left:clamp(40px,4.5vw,88px)}
  .bhalf-inner{max-width:500px}
  .blabel{display:block;font-family:var(--script);font-weight:400;font-size:clamp(2.1rem,3.4vw,3.2rem);line-height:1;margin-bottom:20px;transform:rotate(-2deg);transform-origin:left bottom}
  .bstatement{font-family:var(--display);font-weight:500;font-size:clamp(1.7rem,2.8vw,2.5rem);line-height:1.22;letter-spacing:-.005em;text-wrap:balance}
  .bstatement.bsm{font-size:clamp(1.15rem,1.7vw,1.5rem);line-height:1.5}
  .humility{margin-top:30px;font-family:var(--script);font-style:normal;font-size:clamp(1.3rem,1.9vw,1.65rem);line-height:1.55;color:rgba(255,255,255,.95);max-width:46ch}

  /* ---------- TEAM ---------- */
  .team{background:var(--paper)}
  .team .body{margin:10px 0 44px;max-width:none}
  .tgrid{display:grid;grid-template-columns:repeat(4,1fr);gap:40px 28px}
  .tcard{margin:0;text-align:center}
  .pface{display:block;width:min(200px,100%);aspect-ratio:1/1;border-radius:50%;overflow:hidden;margin:0 auto 16px}
  .pface img{width:100%;height:100%;object-fit:cover}
  .tcard figcaption strong{display:block;font-family:var(--display);font-weight:600;font-size:1.12rem;color:var(--deep)}
  .tcard figcaption span{display:block;font-size:.88rem;color:var(--slate);margin-top:3px;line-height:1.45}

  /* ---------- CONVERSION BAND ---------- */
  .convert{background:var(--deep2);color:#fff}
  .convert .title{color:#fff;margin-bottom:40px}
  .cgrid{display:grid;grid-template-columns:repeat(3,1fr);gap:22px;align-items:stretch}
  .ccard{border-radius:18px;padding:clamp(26px,2.8vw,38px);display:flex;flex-direction:column;gap:14px}
  .ccard h3{font-family:var(--display);font-weight:600;font-size:1.45rem}
  .ccard p{font-size:.98rem;line-height:1.6;flex:1}
  .c-green{background:var(--green);color:#fff}
  .c-blue{background:var(--ocean);color:#fff}
  .c-sand{background:#FFFFFF;color:var(--deep2)}
  .ccard form{display:flex;flex-direction:column;gap:10px;width:100%;min-width:0}
  .ccard input{min-width:0;width:100%;max-width:100%;box-sizing:border-box;padding:12px 14px;border-radius:10px;border:none;font:inherit;font-size:1rem}
  .cbtn{background:#fff;color:var(--deep);border-radius:999px;padding:12px 20px;font-weight:600;text-align:center;justify-content:center;display:inline-flex;width:100%;max-width:100%;white-space:normal;box-sizing:border-box}
  .cbtn:hover{background:var(--paper2)}
  .cbtn.dark{background:var(--deep2);color:#fff}
  .cbtn.dark:hover{background:var(--deep)}
  .ccta{display:flex;flex-direction:column;align-items:center;gap:10px;width:100%}
  .ccta .cbtn{width:100%}
  .cemail{display:inline-block;text-align:center;font-size:.92rem;font-weight:500;color:rgba(255,255,255,.92);text-decoration:underline;text-underline-offset:3px}
  .cemail:hover{color:#fff}
  .crow{display:flex;flex-wrap:wrap;gap:10px;width:100%}
  .crow .cbtn{flex:1 1 calc(50% - 5px);width:auto;font-size:.9rem;padding:11px 14px}
  .crow .cbtn:last-child{flex:1 1 100%}

  /* ---------- BOARD + ADVISORY ---------- */
  .governance{background:var(--mist)}
  .governance .eyebrow{display:block;margin-bottom:28px}
  .gov-second{margin-top:64px}
  .ggrid{display:grid;grid-template-columns:repeat(4,1fr);gap:32px 24px}
  .ggrid.g3{grid-template-columns:repeat(3,1fr);max-width:880px}
  .gcard{margin:0;text-align:center}
  .gcard .pface{width:min(200px,100%)}
  .gcard figcaption strong{display:block;font-family:var(--display);font-weight:600;font-size:1.02rem;color:var(--deep)}
  .gcard figcaption span{display:block;font-size:.82rem;color:var(--slate);margin-top:3px;line-height:1.45}

  /* ---------- responsive ---------- */
  @media(max-width:1100px){
    .tgrid{grid-template-columns:repeat(3,1fr)}
  }
  @media(max-width:940px){
    .story-grid{grid-template-columns:1fr}
    .story-photos{position:static;grid-template-columns:1fr 1fr;align-items:start}
    .sphoto.live{grid-column:1/-1}
    .believe-halves{grid-template-columns:1fr}
    .bh-vision,.bh-mission{justify-content:center;padding-left:28px;padding-right:28px}
    .cgrid{grid-template-columns:1fr}
    .ggrid,.ggrid.g3{grid-template-columns:repeat(2,1fr)}
  }
  @media(max-width:560px){
    .wrap{padding:0 22px}
    .story-grid{padding:0 22px}
    .tgrid{grid-template-columns:repeat(2,1fr);gap:30px 16px}
    .pface{width:min(140px,100%)}
    .story-photos{grid-template-columns:1fr}
    .hero-caption{position:static;display:block;padding:10px 22px 0;transform:none;text-align:right}
    .about-hero{flex-direction:column;align-items:stretch;justify-content:flex-end}
    .about-hero-inner{padding-bottom:14px}
    .ggrid,.ggrid.g3{grid-template-columns:1fr 1fr}
  }
</style>

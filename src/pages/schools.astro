  .lb.open{display:grid}
  .lb-inner{width:min(980px,94vw);aspect-ratio:16/9;position:relative}
  #lbSlot{position:absolute;inset:0;width:100%;height:100%}
  #lbSlot iframe{width:100%;height:100%;border:0;border-radius:14px;display:block}
  .lb-close{position:absolute;top:-48px;right:0;background:none;border:1px solid rgba(255,255,255,.55);color:#fff;border-radius:50%;width:40px;height:40px;cursor:pointer;font-size:1.3rem;line-height:1}
</style>

<script>
  // Page-specific behaviour not covered by src/scripts/*: video lightbox (with playlist
  // support) and the scroll-driven "how the change happens" pond ripple. Ported verbatim
  // from the source fs_review1/index.html inline <script> (nav scroll, hero entrance,
  // reveal-on-scroll are already handled globally by BaseLayout's animations.js/nav.js).
  // Note: the source page's click-to-expand interactive ripple script (selectRing/.rrings)
  // and the window.SEAMS resolver are dropped — that markup isn't used on this page (see
  // .fsr instead), and seam URLs are now resolved server-side via src/config/seams.ts.
  import { trackEvent } from '../scripts/analytics.js';
  import { youtubeIframeHtml } from '../scripts/youtube-embed.js';
  import { attachLightboxA11y } from '../scripts/lightbox-a11y.js';

  document.querySelectorAll<HTMLAnchorElement>('[data-school-inquiry-source]').forEach((link) => {
    link.addEventListener('click', () => {
      trackEvent('school_partner_inquiry_started', { source: link.dataset.schoolInquirySource || 'unknown' });
    });
  });

  document.querySelectorAll<HTMLAnchorElement>('[data-partner-deck-source]').forEach((link) => {
    link.addEventListener('click', () => {
      trackEvent('partner_deck_downloaded', { source: link.dataset.partnerDeckSource || 'unknown' });
    });
  });

  const lb = document.getElementById('lb');
  const lbSlot = document.getElementById('lbSlot');
  const lbClose = document.getElementById('lbClose');

  // Focus management for the cross-origin YouTube frame — see lightbox-a11y.js.
  // The old `window`-scoped Escape handler could never fire once focus was inside
  // the player, which made this a real keyboard trap (WCAG 2.1.2 A).
  const lbA11y = attachLightboxA11y(lb!, lbClose!, () => closeLb());

  function openLb(id: string, list?: string, trigger?: HTMLElement) {
    if (!lbSlot || !lb) return;
    lbSlot.innerHTML = youtubeIframeHtml(id, {
      list,
      style: 'width:100%;height:100%;border:0;border-radius:14px;display:block',
    });
    lb.classList.add('open');
    lbA11y.opened(trigger);
  }
  function closeLb() {
    if (!lbSlot || !lb) return;
    lb.classList.remove('open');
    lbSlot.innerHTML = '';
    lbA11y.closed();
  }
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    const go = () => openLb(el.dataset.yt as string, el.dataset.list, el);
    el.addEventListener('click', go);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
    });
  });
  lbClose?.addEventListener('click', closeLb);
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });

  // Fold 7 — scroll-driven pond ripple (mirrors src/scripts/orbit.js / homepage RF-002).
  // Mobile/tablet use the same scroll-driven reveal as desktop (rings + ground color +
  // one beat at a time). Static stacked beats only for prefers-reduced-motion.
  (function () {
    const sec = document.querySelector<HTMLElement>('.fsr');
    if (!sec) return;
    const rings = [...sec.querySelectorAll<HTMLElement>('.fsr-ring')];
    const beats = [...sec.querySelectorAll<HTMLElement>('.fsr-beat')];
    const N = beats.length;
    const GROUNDS = ['#0090be', '#32c0cf', '#54bf98', '#e3b25d'];
    const reduce = window.matchMedia('(prefers-reduced-motion:reduce)').matches;

    function setActive(i: number) {
      beats.forEach((b, bi) => { b.classList.toggle('active', bi === i); b.classList.toggle('past', bi < i); });
      rings.forEach((r, ri) => { r.classList.toggle('drawn', ri <= i); r.classList.toggle('current', ri === i); });
      sec!.style.setProperty('--fob', GROUNDS[i] || GROUNDS[0]);
    }

    if (reduce) {
      setActive(0);
      sec.style.removeProperty('--fob');
      sec.style.setProperty('--bloom', '360');
      const io = new IntersectionObserver((es) => {
        es.forEach((e) => {
          if (e.isIntersecting) {
            const i = +(e.target as HTMLElement).dataset.beat!;
            rings.forEach((r, ri) => r.classList.toggle('drawn', ri <= i));
            e.target.classList.add('active');
          }
        });
      }, { threshold: .6 });
      beats.forEach((b) => io.observe(b));
      return;
    }

    let cur = -1;
    const cue = sec.querySelector('.fsr-cue');
    const lerp = (a: number, b: number, t: number) => a + (b - a) * t;
    const mobileFsr = window.matchMedia('(max-width:940px)');

    function onScroll() {
      const rect = sec!.getBoundingClientRect();
      const total = Math.max(sec!.offsetHeight - window.innerHeight, 1);
      let prog = Math.min(Math.max(-rect.top / total, 0), 1);
      // Cap bloom on stacked mobile so the glow doesn't wash over beat copy (RF-002).
      const bloomMax = mobileFsr.matches ? 280 : 760;
      const bloomMin = mobileFsr.matches ? 110 : 150;
      sec!.style.setProperty('--bloom', lerp(bloomMin, bloomMax, prog).toFixed(0));
      const eased = Math.pow(prog, 0.82);
      let i = Math.floor(eased * N);
      if (i > N - 1) i = N - 1;
      if (i < 0) i = 0;
      if (i !== cur) { cur = i; setActive(i); }
      if (cue) {
        const pinned = rect.top <= 0 && rect.bottom > window.innerHeight;
        if (i >= N - 1 || !pinned) { cue.classList.add('hide'); } else { cue.classList.remove('hide'); }
      }
    }
    setActive(0);
    addEventListener('scroll', onScroll, { passive: true });
    addEventListener('resize', onScroll);
    onScroll();
  })();
</script>

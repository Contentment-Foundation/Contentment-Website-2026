---
// Get Involved (Homeroom / monthly giving) — migrated verbatim from Dave's Jul 28 2026 handoff:
// handoff/2026-07-29-dave-pages/6_GET INVOLVED/get-involved-project-2026-07-28/get-involved.html
// (the de-inlined "project tree" form, per its own TECH-WIRING-HANDOFF.md — canonical repo copy).
// See docs/planning/TECHNICAL-ARCHITECTURE.md §3 — no redesign, structure/CSS copied as-is.
// Shared <Nav />/<Footer /> replace this page's own header/footer markup (deleted per
// migration hard rules); nav/footer seams (about/why/our-impact/schools/events/getinvolved,
// donate, schoolPlatform, social links) are wired centrally in Nav.astro/Footer.astro
// via src/config/seams.ts — nothing further to do for them here.
//
// This page's photos are base64-embedded on purpose (handoff §7: "design's call, not
// something to optimize into an assets folder") — every data: URI below is preserved
// byte-for-byte from the source, including the shared white-texture --tex-white variable
// and the tier-3 ripple mask image.
//
// Route: /getinvolved (was /give). D-03 / HC-031 still open on whether this stays a
// single gateway or later splits a monthly subpath — that does not change this slug.
import BaseLayout from '../layouts/BaseLayout.astro';
import KeelaDonateForm from '../components/KeelaDonateForm.astro';
import { seams } from '../config/seams';

const joinFallback = seams.join || '/getinvolved';
const tierUrls = {
  25: seams.joinTiers?.[25] || '',
  50: seams.joinTiers?.[50] || '',
  100: seams.joinTiers?.[100] || '',
};
/** Interim: selected tier → homepage Keela form with amount. Prefer live joinTiers when set. */
const defaultTierHref =
  tierUrls[100] ||
  seams.homeroomDonateUrl(100) ||
  (joinFallback.startsWith('http') ? joinFallback : '/?amount=100&frequency=monthly#homeroom');
const defaultTierExternal = defaultTierHref.startsWith('http');
---
<BaseLayout
  keela
  title="Get Involved — The Contentment Foundation"
  description="A movement for teachers needs more than money. It needs you. Join Homeroom, bring it to your school, spread the word, or experience it yourself."
>

<section class="gi-hero">
  <div class="gi-hero-bg" style="background-image:url('/assets/gi-hero.jpg')"></div>
  <div class="gi-hero-bg mob" style="background-image:url('/assets/gi-hero-mob.jpg')"></div>
  <div class="wrap gi-hero-wrap">
    <div class="gi-hero-inner">
      <h1 class="anim"><span class="h1-name">Homeroom</span><span class="h1-sub">Our Monthly Giving Community</span></h1>
      <p class="gi-hero-lead anim d1">Join a global community of monthly givers who keep wellbeing programs running for teachers everywhere.</p>
      <div class="hero-actions anim d2">
        <!-- SEAM: Keela/Homeroom join flow -->
        <a href="#become" class="btn btn-join">Join Homeroom <span class="arrow">&rarr;</span></a>
      </div>
      <a href="#benefits" class="hero-seelink anim d2">See what members receive</a>
    </div>
  </div>
  <a class="scrollcue" href="#what" aria-label="Scroll"><span class="dot"></span></a>
</section>

<!-- WHAT IS HOMEROOM - full-bleed split, video on right -->
<section class="split gi-what-split" id="what">
  <div class="split-txt">
    <div class="split-txt-inner anim">
      <h2 class="title">What is <span class="script">Homeroom?</span></h2>
      <p class="body">Think of Homeroom as our home base: a recurring community of supporters who believe wellbeing belongs to everyone, everywhere, especially teachers. Your monthly gift keeps the doors open, the programs running, and the community growing.</p>
      <p class="body">Becoming a member takes just a few minutes, and you choose the giving level that feels right for you.</p>
      <p class="body jose-lead">Meet Jose from Singapore who has been a Homeroom member since 2024:</p>
    </div>
  </div>
  <div class="split-img gi-what-media">
    <!-- SEAM: impact-video. PORTRAIT 9:16 per WJ. Member recording pending;
         drop the real embed straight into this slot. -->
    <div class="gi-what-video" data-embed="impact-video" role="img" aria-label="Member video coming soon">
      <span class="gi-play" aria-hidden="true"></span>
      <span class="gi-embed-label">Why I give every month</span>
      <span class="gi-embed-sub">Portrait video &middot; tech to wire</span>
    </div>
  </div>
</section>

<!-- MEMBER BENEFITS -->
<section class="band gi-benefits" id="benefits">
  <div class="wrap">
    <div class="gi-benefits-head anim">
      <h2 class="title">Deep gratitude for your support</h2>
      <p class="body">You show up for teachers every month. Here's how we show up for you.</p>
    </div>
    <div class="benefit-grid">

      <!-- FEATURED: Events + Experiences (white panel-left + photo-right) -->
      <article class="bcard bcard-feature anim">
        <div class="bfeat-panel">
          <span class="beyebrow">Events + Experiences</span>
          <p class="bbody">You're invited to member-only gatherings such as our monthly 'Heart Circles' and 'Community Town Halls'. These are moments in time we can sit together to reflect, and remember why this work matters.</p>
        </div>
        <div class="bphoto" style="background-image:url('/assets/gi-bphoto-1.jpg')"></div>
      </article>

      <!-- The Retreat -->
      <article class="bcard bcard-photo anim">
        <div class="bphoto" style="background-image:url('/assets/gi-bphoto-2.jpg')"></div>
        <div class="bcard-body">
          <span class="beyebrow">The Retreat</span>
          <p class="bbody">Our flagship retreat, and we have your seat saved for you every year. You'll be first in line to hear about the retreat before we announce it to the general public.</p>
        </div>
      </article>

      <!-- The Platform -->
      <article class="bcard bcard-photo anim">
        <div class="bphoto" style="background-image:url('/assets/gi-bphoto-3.jpg')"></div>
        <div class="bcard-body">
          <span class="beyebrow">The Platform</span>
          <p class="bbody">The same wellbeing platform our teachers use, open to you completely. Built on scientifically evidenced Four Pillars of Wellbeing, it meets you where you are in life.</p>
        </div>
      </article>

      <!-- The Community -->
      <article class="bcard bcard-photo anim">
        <div class="bphoto" style="background-image:url('/assets/gi-bphoto-4.jpg')"></div>
        <div class="bcard-body">
          <span class="beyebrow">The Community</span>
          <p class="bbody">Friends from all over the world. Members who've never met will greet each other like old friends because you're curious about wellbeing, share similar values and most likely are already exploring it in your own way.</p>
        </div>
      </article>

      <!-- The Group Chat -->
      <article class="bcard bcard-photo anim">
        <div class="bphoto" style="background-image:url('/assets/gi-bphoto-5.jpg')"></div>
        <div class="bcard-body">
          <span class="beyebrow">The Group Chat</span>
          <p class="bbody">You'll receive exclusive emails and be invited to a cosy Whatsapp Group. This is where retreat photos will land, small wins are celebrated and nobody feels left out between gatherings.</p>
        </div>
      </article>

    </div>
  </div>
</section>

<!-- PRISCILLAH QUOTE BAND (warm paper break before the ask) -->
<section class="quoteband">
  <div class="wrap quoteband-inner anim">
    <h2 class="quoteband-title">This is why you show up every month</h2>
    <blockquote class="quoteband-q">&#8220;You didn't just fund a program. You changed a teacher. You uplifted a staff. You healed a school. And for that, I will remain grateful for the rest of my life.&#8221;</blockquote>
    <cite class="quoteband-cite"><b>Priscillah Njuguna</b> Educator, OLC Mugoiri Girls High School, Kenya</cite>
  </div>
</section>

<!-- BECOME A MEMBER (content-left + full-bleed photo-right) -->
<section class="become-split" id="become">
  <div class="become-content">
    <div class="become-content-inner anim">
      <h2 class="become-title">Join <span class="script">Homeroom</span></h2>
      <p class="become-body">You believe that when one teacher thrives, generations flourish. You also care to see wellbeing as the foundation of schools, not just a nice-to-have. When you give monthly, you join Homeroom: people around the world who keep showing up for teachers, month after month.</p>
      <p class="become-sub">Ready to join? Choose your monthly giving level and become part of Homeroom today.</p>
      <div
        class="tiers"
        role="radiogroup"
        aria-label="Monthly giving level"
        data-join-fallback={seams.homeroomDonateUrl(100)}
        data-tier-25={tierUrls[25]}
        data-tier-50={tierUrls[50]}
        data-tier-100={tierUrls[100]}
      >
        <button type="button" class="tier tier-1" role="radio" aria-checked="false" data-amount="25" data-tier="dreamer">
          <span class="amt">$25<span>/mo</span></span>
          <div class="tcopy">
            <span class="tname">Dreamer</span>
            <span class="tdesc">Helps train an educator each year.</span>
          </div>
        </button>
        <button type="button" class="tier tier-2" role="radio" aria-checked="false" data-amount="50" data-tier="catalyst">
          <span class="amt">$50<span>/mo</span></span>
          <div class="tcopy">
            <span class="tname">Catalyst</span>
            <span class="tdesc">Helps bring this training to a classroom community.</span>
          </div>
        </button>
        <button type="button" class="tier tier-3 is-selected" role="radio" aria-checked="true" data-amount="100" data-tier="visionary">
          <span class="amt">$100<span>/mo</span></span>
          <div class="tcopy">
            <span class="tname">Visionary</span>
            <span class="tdesc">Helps scale training across teams of educators.</span>
          </div>
        </button>
      </div>
      <p class="tier-note">Together with other monthly donors, each gift contributes to one fully trained educator each year and the students they reach.</p>
      <div class="homeroom-cta">
        <!-- SEAM: Prefer joinTiers when set; else homepage Keela form with selected amount. -->
        <a
          href={defaultTierHref}
          class="btn btn-primary"
          data-join="homeroom"
          data-selected-amount="100"
          {...(defaultTierExternal ? { target: '_blank', rel: 'noopener' } : {})}
        >Join Homeroom <span class="arrow">&rarr;</span></a>
        <p class="taxline">Contentment Foundation is a 501(c)(3) nonprofit (EIN 47-5432756), and your contributions are tax-deductible to the extent permitted by law. Thank you for being part of this work.</p>
      </div>
    </div>
  </div>
  <div class="become-photo" style="background-image:url('/assets/gi-become.jpg')" role="img" aria-label="Two members at a Contentment gathering"></div>
</section>

<!-- DONATE (photo-left + Keela form on blue) — image: public/assets/gi-donate-photo.jpg -->
<section class="gi-donate-split" id="donate">
  <div
    class="gi-donate-photo"
    role="img"
    aria-label="Community members forming a heart with their hands during a Contentment gathering"
    style="background-image:url('/assets/gi-donate-photo.jpg')"
  ></div>
  <div class="gi-donate-panel">
    <div class="gi-donate-inner anim">
      <KeelaDonateForm source="getinvolved_donate_split" />
      <p class="gi-donate-fine">Cancel anytime. Gifts are unrestricted.</p>
      <p class="gi-donate-legal">Contentment Foundation is a 501(c)(3) nonprofit (EIN 47-5432756), and your contributions are tax-deductible to the extent permitted by law. Thank you for being part of this work.</p>
    </div>
  </div>
</section>

<!-- OTHER WAYS -->
<section class="band-tight gi-other">
  <div class="wrap gi-other-inner anim">
    <div class="gi-other-txt">
      <h2 class="title">Prefer to give differently?</h2>
      <p class="body">You can make a one-time gift or explore other ways to be part of the movement. However you show up, it matters.</p>
    </div>
    <div class="gi-other-actions">
      <a href="#donate" class="btn btn-primary" data-join="one-time">Make a one-time gift <span class="arrow">&rarr;</span></a>
      <a href={seams.waysToGive || 'mailto:hello@contentment.org'} class="btn btn-outline" data-join="ways-to-give">Email us</a>
    </div>
  </div>
</section>


</BaseLayout>

<style>
  /* Page-specific CSS only — reset/wrap/eyebrow/buttons(.btn,.btn-primary,.btn-ghost)/
     nav/footer/.anim/section-typography system are already in src/styles/global.css
     (verified, see TECHNICAL-ARCHITECTURE §3 and why.astro for the pattern). Kit
     boilerplate sections Dave's source carries but this page's markup never uses
     (.impact, .how*, .how-orbit/.orbit-*, .alone/.circles, .pillars*, .doors*, .voice*,
     .news*, the full .homeroom grid/.homeroom-img/.homeroom-panel/.homeroom-inner/
     .homeroom-head, .gi-why-* / .gi-media / .gi-embed-slot / .gi-keela-slot, .ask-quote/
     .ask-head/.ask-copy, and the .gi-hero .btn-primary rules — the hero button is
     actually .btn-join, not .btn-primary) are omitted as dead CSS, no matching markup.
     .tiers/.tier* and .homeroom-cta ARE used (inside the Join Homeroom / become-split
     section) even though their base rules live in Dave's boilerplate kit block, and
     are kept below along with this page's own "GET INVOLVED" + "PHASE 1 TEAM REVIEW"
     sections, preserved in original cascade order since later rules there intentionally
     override earlier ones at matching specificity. */

  /* New CSS custom properties this page introduces (V's phase-1 review palette + the
     shared white-texture data URI). :global() is required here: Astro scopes a page's
     own <style> block by rewriting selectors to include a data-astro-cid attribute,
     but the actual <html>/root element is rendered by BaseLayout, not this page, so a
     plain `:root{...}` rule would never match and these variables would silently not
     apply. :global(:root) opts this one rule out of scoping so it reaches the real root. */
  :global(:root){
    --v-cyan:#32c0cf;      /* card subheads, What is Homeroom?, cite name, hero button */
    --v-mint:#54bf98;      /* benefits band, Events & Experiences header */
    --v-sand:#f9dba6;      /* hero subhead + hero text link */
    --v-ink:#1d1d1d;       /* body text default this round */
    --v-blue:#0090be;      /* quote, join button, footer */
    --v-deep:#024e70;      /* Join Homeroom title, tier 1 */
    --v-teal2:#3cb4c2;     /* tier 2 */
    --v-mint2:#55bf97;     /* tier 3 */
    --v-overlay:0,123,141; /* #007b8d hero gradient overlay, as rgb parts */
    /* white textured block, embedded once and shared by both light sections */
    --tex-white:url('/assets/gi-tex-white.jpg');
  }

  .script{font-family:var(--script);font-weight:400;font-size:1.1em;line-height:.95;display:inline-block;transform:translateY(.05em)}

  /* ---------- HERO ---------- */
  .gi-hero{position:relative;min-height:100svh;height:100svh;display:flex;align-items:center;color:#fff;overflow:hidden;background:var(--deep2)}
  .gi-hero-bg{position:absolute;inset:0;background-size:cover;background-position:center 46%;transform:scale(1.06);animation:heroZoom 18s ease-out forwards;will-change:transform}
  .gi-hero-bg.mob{display:none}
  .gi-hero::after{content:"";position:absolute;inset:0;background:
    linear-gradient(90deg,
      rgba(var(--v-overlay),.90) 0%,
      rgba(var(--v-overlay),.76) 28%,
      rgba(var(--v-overlay),.44) 52%,
      rgba(var(--v-overlay),.16) 74%,
      rgba(var(--v-overlay),.04) 100%),
    linear-gradient(0deg,
      rgba(var(--v-overlay),.60) 0%,
      rgba(var(--v-overlay),.10) 30%,
      rgba(var(--v-overlay),0) 55%)}
  .gi-hero-wrap{width:100%}
  .gi-hero-inner{position:relative;z-index:2;max-width:560px;will-change:transform}
  .gi-hero h1{font-family:var(--display);font-weight:500;line-height:1;letter-spacing:-.01em;text-shadow:0 2px 44px rgba(2,40,58,.55);margin:0}
  .gi-hero .h1-name{display:block;font-size:clamp(3.2rem,6.4vw,5.6rem);line-height:1}
  .gi-hero .h1-sub{display:block;font-size:clamp(1.5rem,2.6vw,2.3rem);line-height:1.1;margin-top:.24em;letter-spacing:0;color:var(--v-sand)}
  .gi-hero-lead{margin-top:20px;font-size:clamp(1.08rem,1.35vw,1.24rem);line-height:1.5;color:rgba(255,255,255,.94);max-width:46ch;text-shadow:0 1px 26px rgba(2,40,58,.7)}
  .gi-hero .hero-actions{margin-top:30px;display:flex;gap:14px;flex-wrap:wrap}
  /* V: Join Homeroom button -> #32c0cf fill, #1d1d1d text */
  .gi-hero .btn-join{background:var(--v-cyan);color:var(--v-ink);border-color:transparent;
    box-shadow:0 12px 30px -12px rgba(0,0,0,.45)}
  .gi-hero .btn-join:hover{background:#4bcedc;transform:translateY(-2px);
    box-shadow:0 18px 38px -12px rgba(0,0,0,.5)}
  /* WJ: small text link under the button, jumps to member benefits */
  .hero-seelink{display:inline-block;margin-top:20px;font-size:.95rem;font-weight:500;
    color:var(--v-sand);text-decoration:underline;text-underline-offset:5px;
    text-decoration-thickness:1px;transition:color .25s;
    text-shadow:0 1px 18px rgba(2,40,58,.6)}
  .hero-seelink:hover{color:#fff}
  .gi-hero .scrollcue{position:absolute;left:50%;bottom:16px;transform:translateX(-50%);z-index:3;pointer-events:none;opacity:0;animation:fadeIn .9s 1.4s forwards}
  .gi-hero .scrollcue .dot{width:1px;height:40px;background:linear-gradient(rgba(255,255,255,.7),transparent);display:block}

  /* ---------- WHAT IS HOMEROOM - full-bleed split, video on right ---------- */
  .split{display:grid;grid-template-columns:1fr 1fr;align-items:stretch;min-height:clamp(680px,82vh,920px);max-height:1040px}
  .gi-what-split{background:#fff var(--tex-white) center/cover;
    grid-template-columns:1.08fr .92fr;
    padding-left:max(32px,calc((100% - 1240px) / 2));
    padding-right:max(32px,calc((100% - 1240px) / 2));
    align-items:center;min-height:0;max-height:none;padding-top:clamp(56px,7vw,110px);padding-bottom:clamp(56px,7vw,110px)}
  .split-txt{display:flex;align-items:center;padding:clamp(48px,7vw,104px) clamp(36px,6vw,92px)}
  .split-txt-inner{max-width:540px}
  .gi-what-split .split-txt{padding:0 clamp(18px,2.4vw,44px) 0 0;justify-content:flex-end}
  .gi-what-split .split-txt-inner{max-width:560px;margin:0}
  .gi-what-split .split-txt-inner h2{margin-bottom:22px}
  .gi-what-split .title{color:var(--v-cyan)}
  .gi-what-split .body{color:var(--v-ink)}
  .jose-lead{font-weight:500;color:var(--v-ink)}
  .gi-what-media{padding:0 0 0 clamp(18px,2.4vw,44px);display:flex;align-items:center;justify-content:flex-start}
  /* SEAM: portrait (9:16) placeholder. Real member video pending recording. */
  /* margin:0 here, not `0 auto`: auto margins on a flex item beat the
     container's justify-content and re-centre the player, reopening the gap. */
  .gi-what-video{position:relative;width:100%;max-width:372px;aspect-ratio:9/16;margin:0;min-height:0;border-radius:16px;overflow:hidden;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:10px;text-align:center;color:#fff;background:linear-gradient(150deg,var(--ocean) 0%,var(--deep) 58%,var(--deep2) 100%);box-shadow:var(--shadow);cursor:pointer}
  .gi-what-video::before{content:"";position:absolute;width:300px;height:300px;border-radius:50%;border:1px solid rgba(255,255,255,.10);top:-100px;right:-90px;pointer-events:none}
  .gi-what-video::after{content:"";position:absolute;width:220px;height:220px;border-radius:50%;border:1px solid rgba(255,255,255,.08);bottom:-80px;left:-70px;pointer-events:none}
  .gi-play{position:relative;z-index:2;width:76px;height:76px;border-radius:50%;background:rgba(255,255,255,.16);border:1.5px solid rgba(255,255,255,.55);display:grid;place-items:center;margin-bottom:8px;transition:transform .3s,background .3s}
  .gi-play::after{content:"";border-style:solid;border-width:13px 0 13px 21px;border-color:transparent transparent transparent #fff;margin-left:5px}
  .gi-what-video:hover .gi-play{transform:scale(1.08);background:rgba(255,255,255,.24)}
  .gi-embed-label{position:relative;z-index:2;font-family:var(--display);font-weight:500;font-size:1.5rem}
  .gi-embed-sub{position:relative;z-index:2;font-size:.78rem;letter-spacing:.14em;text-transform:uppercase;color:rgba(255,255,255,.72)}
  .gi-what-video .gi-embed-label{font-size:1.24rem;max-width:16ch;line-height:1.25}

  /* ---------- MEMBER BENEFITS ---------- */
  /* V: band background -> #54bf98 flat. Section head colour was NOT specified
     by V; Dave's call is white (#1d1d1d read too heavy against the mint).
     Documented: white on #54bf98 is 2.26:1, under AA. Subhead follows the
     header so the two don't split. */
  .gi-benefits{background:var(--v-mint);color:#fff}
  .gi-benefits-head{max-width:none;margin-bottom:clamp(32px,4vw,48px)}
  .gi-benefits-head h2{margin:0 0 14px;color:#fff}
  .gi-benefits-head .body{max-width:none;white-space:normal;color:#fff;opacity:.92}
  .benefit-grid{display:grid;grid-template-columns:repeat(2,1fr);gap:clamp(20px,2.4vw,30px)}

  /* generic card shell */
  .bcard{border-radius:22px;overflow:hidden;background:#fff;box-shadow:0 20px 60px -34px rgba(2,40,58,.7);display:flex;flex-direction:column}

  /* photo slot placeholder (duotone until real crops drop in) */
  .bphoto{position:relative;background:linear-gradient(150deg,#0a93c0 0%,var(--ocean) 55%,var(--deep) 100%);background-size:cover;background-position:center;overflow:hidden;flex:none}
  .bphoto::before{content:attr(data-photo);position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-family:var(--body);font-size:.72rem;letter-spacing:.16em;text-transform:uppercase;color:rgba(255,255,255,.6);text-align:center;padding:16px}
  .bphoto[style]::before{content:none}

  /* FEATURED card: full width, photo-left + colored panel-right */
  .bcard-feature{grid-column:1 / -1;flex-direction:row;align-items:stretch}
  .bcard-feature .bphoto{width:47%;min-height:clamp(320px,32vw,460px);align-self:stretch;height:auto;background-position:center 22%}
  .bfeat-panel{flex:1;background:#fff;color:var(--v-ink);padding:clamp(36px,4vw,60px);display:flex;flex-direction:column;justify-content:center}
  .bfeat-panel .beyebrow{color:var(--v-mint)}
  .bfeat-panel .bbody{color:var(--v-ink)}
  .bfeat-panel .bbold{color:var(--v-ink)}

  /* GRID card: photo-top + white content-below */
  .bcard-photo{grid-column:span 1}
  .bcard-photo .bphoto{width:100%;aspect-ratio:16/10}
  .bcard-body{padding:clamp(26px,2.4vw,34px) clamp(26px,2.4vw,32px) clamp(30px,2.8vw,38px)}
  .bcard-photo .beyebrow{color:var(--v-cyan)}
  .bcard-photo .bbody{color:var(--v-ink)}

  /* shared typographic bits */
  .beyebrow{display:block;font-size:.74rem;letter-spacing:.16em;text-transform:uppercase;font-weight:600;color:var(--ocean);margin-bottom:16px}
  .bbody{font-size:1.02rem;line-height:1.6;color:var(--slate)}
  .bbold{display:block;margin-top:16px;font-weight:600;font-size:1.02rem;line-height:1.55;color:var(--deep)}

  /* ---------- PRISCILLAH QUOTE BAND ---------- */
  /* warm paper, text-only emotional beat before the ask. Holding pattern: WJ is
     replacing this quote, so no headshot fitted (see handoff §8 — not a bug). */
  .quoteband{background:var(--paper);color:var(--ink);padding:clamp(72px,11vw,150px) 0;position:relative;overflow:hidden}
  .quoteband::before{content:"";position:absolute;width:640px;height:640px;border-radius:50%;border:1px solid rgba(2,55,79,.06);top:-260px;right:-180px;pointer-events:none}
  .quoteband::after{content:"";position:absolute;width:440px;height:440px;border-radius:50%;border:1px solid rgba(2,55,79,.05);bottom:-220px;left:-140px;pointer-events:none}
  .quoteband-inner{position:relative;z-index:2;max-width:1180px;text-align:center}
  .quoteband-title{font-family:var(--display);font-weight:500;color:var(--v-ink);
    font-size:clamp(1.5rem,2.5vw,2.1rem);line-height:1.15;margin:0 0 clamp(26px,3vw,38px);
    text-wrap:balance}
  .quoteband-q{font-family:var(--display);font-weight:500;font-style:italic;font-size:clamp(1.6rem,3vw,2.6rem);line-height:1.3;letter-spacing:-.01em;color:var(--v-blue);margin:0;text-wrap:balance}
  .quoteband-cite{display:block;margin-top:clamp(28px,3.4vw,44px);font-style:normal;font-size:1rem;line-height:1.5;color:var(--v-ink)}
  .quoteband-cite b{display:block;font-weight:700;color:var(--v-cyan);font-size:1.06rem;margin-bottom:2px}

  /* ---------- JOIN HOMEROOM (become-split; content-left + full-bleed photo-right) ---------- */
  /* V: background -> white textured block. Photo half retained. */
  .become-split{display:grid;grid-template-columns:1.05fr 0.95fr;align-items:stretch;min-height:clamp(640px,82vh,940px);position:relative;overflow:hidden;background:#fff;color:var(--v-ink)}
  .become-content{display:flex;align-items:center;padding:clamp(56px,6vw,104px) clamp(34px,5vw,84px);background:#fff var(--tex-white) center/cover}
  .become-content-inner{position:relative;z-index:2;max-width:560px;margin-left:auto;width:100%}
  .become-title{font-family:var(--display);font-weight:500;color:var(--v-deep);font-size:clamp(2.4rem,4.2vw,3.4rem);line-height:1.04;letter-spacing:-.005em}
  .become-body{margin:18px 0 0;font-size:clamp(1rem,1.15vw,1.1rem);color:var(--v-ink);
    max-width:52ch;line-height:1.6}
  .become-sub{color:var(--v-ink);margin-top:22px;font-weight:500;font-size:clamp(1.05rem,1.25vw,1.18rem)}
  .become-content-inner .tiers{margin-top:clamp(28px,3vw,40px);display:grid;gap:20px}
  .become-photo{background-size:cover;background-position:center 28%;min-height:clamp(420px,50vh,940px)}

  /* base tier list (shared across the site's kit; get-involved is the only page
     currently rendering it — no equivalent in global.css) */
  .tiers{display:grid;grid-template-columns:1fr;gap:12px;margin:30px 0 26px}
  .tier{display:flex;align-items:baseline;gap:18px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.15);border-radius:16px;padding:18px 22px;transition:transform .3s,background .3s,border-color .3s}
  .tier:hover{transform:translateX(5px);background:rgba(255,255,255,.11);border-color:var(--teal)}
  .tier .amt{font-family:var(--display);font-size:1.7rem;font-weight:600;color:#fff;white-space:nowrap;flex:0 0 auto;min-width:5.4ch}
  .tier .amt span{font-size:.84rem;color:rgba(255,255,255,.7);font-family:var(--body);font-weight:400}
  .tier .tcopy{display:flex;flex-direction:column;gap:3px}
  .tier .tname{font-weight:600;color:#bfeef5;font-size:1rem}
  .tier .tdesc{font-size:.9rem;color:rgba(255,255,255,.82);line-height:1.5}

  /* V: per-tier border + text colour on white */
  .become-split .tier{background-color:#fff;border:1.5px solid var(--line);
    box-shadow:0 10px 30px -22px rgba(2,40,58,.55)}
  /* background-COLOR, never the shorthand: `background:#fff` here resets
     background-image to none and wipes the tier 3 ripple on hover. */
  .become-split .tier:hover{transform:translateX(5px);background-color:#fff}
  .become-split .tier .tdesc{color:var(--v-ink);opacity:.86}
  .become-split .tier .amt span{color:var(--v-ink);opacity:.6}
  /* Specificity note: `.become-split .tier` (0,2,0) sets the border and
     background shorthands, so these per-tier rules must match that weight or
     they silently lose. Do not flatten them back to `.tier-1`. */
  .become-split .tier-1{border-color:var(--v-deep)}
  .become-split .tier-1 .amt,.become-split .tier-1 .tname{color:var(--v-deep)}
  .become-split .tier-2{border-color:var(--v-teal2)}
  .become-split .tier-2 .amt,.become-split .tier-2 .tname{color:var(--v-teal2)}
  /* V: tier 3 ripple, fading to transparent on the left over the card's white.
     The ripple lives on a pseudo-element, NOT on .tier-3 itself: masking the
     element would mask its border and its text along with the artwork.
     Absolutely positioned, so it does not become a flex item of .tier.
     The mask gradient is generated from the source PNG's alpha channel by
     prep_assets.py. Replace the artwork and you must regenerate the mask. */
  .become-split .tier-3,
  .become-split .tier-3:hover{border-color:var(--v-mint2);background-color:#fff;
    position:relative;overflow:hidden}
  .become-split .tier-3::before{content:"";position:absolute;inset:0;z-index:0;
    pointer-events:none;
    background:url('/assets/gi-tier3-tex.jpg') center/cover no-repeat;
    -webkit-mask-image:linear-gradient(90deg,rgba(0,0,0,0.000) 0%,rgba(0,0,0,0.000) 7%,rgba(0,0,0,0.016) 14%,rgba(0,0,0,0.051) 21%,rgba(0,0,0,0.102) 29%,rgba(0,0,0,0.169) 36%,rgba(0,0,0,0.243) 43%,rgba(0,0,0,0.333) 50%,rgba(0,0,0,0.439) 57%,rgba(0,0,0,0.553) 64%,rgba(0,0,0,0.671) 71%,rgba(0,0,0,0.769) 79%,rgba(0,0,0,0.769) 86%,rgba(0,0,0,0.769) 93%,rgba(0,0,0,0.769) 100%);
            mask-image:linear-gradient(90deg,rgba(0,0,0,0.000) 0%,rgba(0,0,0,0.000) 7%,rgba(0,0,0,0.016) 14%,rgba(0,0,0,0.051) 21%,rgba(0,0,0,0.102) 29%,rgba(0,0,0,0.169) 36%,rgba(0,0,0,0.243) 43%,rgba(0,0,0,0.333) 50%,rgba(0,0,0,0.439) 57%,rgba(0,0,0,0.553) 64%,rgba(0,0,0,0.671) 71%,rgba(0,0,0,0.769) 79%,rgba(0,0,0,0.769) 86%,rgba(0,0,0,0.769) 93%,rgba(0,0,0,0.769) 100%)}
  .become-split .tier-3 .amt{position:relative;z-index:1}
  .become-split .tier-3 .amt,.become-split .tier-3 .tname{color:var(--v-mint2)}
  .become-split .tier .tcopy{position:relative;z-index:1}
  /* WJ: closing line beneath the tiers */
  .tier-note{margin-top:20px;font-size:.98rem;line-height:1.55;color:var(--v-ink);
    opacity:.88;max-width:52ch}

  /* base .homeroom-cta layout (kit-shared; only this page currently renders it) +
     become-split-specific refinements, kept in source order since later rules

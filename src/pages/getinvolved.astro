  .become-split .homeroom-cta .btn-primary:hover{background:#00a2d6}
  .become-split .homeroom-cta .fine{color:var(--v-ink);opacity:.72;max-width:none}
  /* WJ: 501(c)(3) line under the button. Literally the fine print. Sized to sit

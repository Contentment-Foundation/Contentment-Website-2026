  }
  .gi-donate-inner{
    width:100%;max-width:46ch;display:flex;flex-direction:column;align-items:stretch;gap:14px;
  }
  .gi-donate-inner .keela-embed-form{min-height:320px}
  .gi-donate-fine{
    margin:0;color:#fff;font-size:.92rem;font-weight:500;opacity:.95;
  }
  .gi-donate-legal{
    margin:0;color:rgba(255,255,255,.88);
    font-size:.78rem;line-height:1.5;opacity:.9;text-wrap:pretty;
  }

  /* ---------- PREFER TO GIVE DIFFERENTLY ---------- */
  .gi-other{background:var(--mist)}
  .gi-other-inner{display:grid;grid-template-columns:1.2fr .8fr;gap:clamp(32px,5vw,72px);align-items:center}
  .gi-other-txt h2{margin:14px 0 16px}
  .gi-other .title{color:var(--v-ink)}
  .gi-other .body{color:var(--v-ink);opacity:.86}
  .gi-other-actions{display:flex;flex-direction:column;gap:14px;align-items:stretch}
  .gi-other-actions .btn{justify-content:center}
  .btn-outline{border-color:var(--ocean);color:var(--ocean);background:transparent}
  .btn-outline:hover{background:var(--ocean);color:#fff;transform:translateY(-2px)}

  /* ---------- RESPONSIVE ---------- */
  /* Locked widths: 320 / 390 / 759 / 768 / 940 / 1280.
     Breakpoints aligned to site system (≤940 stack splits, ≤560 mobile).
     Mid ≤680 collapses benefit grid only — 2×2 still reads at 759/768. */

  @media(max-width:940px){
    .split{grid-template-columns:1fr;min-height:0;max-height:none}

    /* What-is: single column. Drop section side padding so we don't double
       with .split-txt / .gi-what-media gutters (was ~64px each side at 320). */
    .gi-what-split{
      grid-template-columns:1fr;
      padding-left:0;
      padding-right:0;
      padding-bottom:clamp(48px,7vw,90px);
    }
    .gi-what-split .split-txt{
      order:1;
      padding:0 clamp(22px,4vw,48px);
      justify-content:flex-start;
    }
    .gi-what-media{
      order:2;
      min-height:auto;
      padding:clamp(12px,2.4vw,28px) clamp(22px,4vw,48px) 0;
      justify-content:center;
    }
    /* Landscape placeholder when stacked — portrait 9:16 was ~660px tall at 940 */
    .gi-what-video{
      aspect-ratio:16/9;
      max-width:min(520px,100%);
      min-height:0;
      margin:0 auto;
      gap:6px;
    }
    .gi-play{width:56px;height:56px;margin-bottom:2px}
    .gi-play::after{border-width:10px 0 10px 16px;margin-left:3px}
    .gi-what-video .gi-embed-label{font-size:1.05rem;max-width:22ch}
    .gi-embed-sub{font-size:.7rem;letter-spacing:.12em}

    .gi-donate-split{grid-template-columns:1fr;min-height:0}
    .gi-donate-photo{order:1;min-height:min(48vh,400px)}
    .gi-donate-panel{order:2;padding:clamp(36px,6vw,64px) clamp(22px,4vw,48px)}
    .gi-donate-inner{max-width:min(46ch,100%);margin-inline:auto}
    .gi-other-inner{grid-template-columns:1fr;gap:28px}
    .gi-other-actions{flex-direction:row;flex-wrap:wrap}
    .gi-other-actions .btn{flex:1 1 200px;min-width:0;justify-content:center}

    .become-split{grid-template-columns:1fr;min-height:0}
    .become-content{
      order:1;
      padding:clamp(48px,6vw,88px) clamp(22px,4vw,48px);
    }
    .become-content-inner{max-width:none;margin-left:0}
    .become-photo{order:2;min-height:min(52vh,420px)}
    .become-split .homeroom-cta{align-items:stretch}
    .become-split .homeroom-cta .btn-primary{width:100%;max-width:360px;margin-inline:auto;justify-content:center}
  }

  @media(max-width:680px){
    .benefit-grid{grid-template-columns:1fr}
    .bcard-feature{flex-direction:column}
    /* Dean / Events photo: match other benefit cards (image above text on mobile) */
    .bcard-feature .bphoto{order:-1;width:100%;aspect-ratio:16/10;min-height:0}
    .bfeat-panel{padding:clamp(24px,5vw,36px)}
    .gi-hero .hero-actions .btn{width:100%;justify-content:center}
    .gi-other-actions{flex-direction:column}
    .gi-other-actions .btn{flex:none;width:100%}
  }

  @media(max-width:560px){
    .gi-hero-bg{display:none}
    .gi-hero-bg.mob{display:block;background-position:center 55%}
    /* mobile hero crop is tight on the embrace; lift the scrim from the bottom
       so the centred text block still clears the faces */
    .gi-hero::after{background:linear-gradient(0deg,
      rgba(var(--v-overlay),.92) 0%,
      rgba(var(--v-overlay),.68) 32%,
      rgba(var(--v-overlay),.40) 62%,
      rgba(var(--v-overlay),.50) 100%)}
    .gi-hero{align-items:flex-end;padding-bottom:clamp(56px,12vh,96px)}
    .gi-hero-inner{max-width:none;padding-bottom:8px}
    .gi-hero .h1-name{font-size:clamp(2.55rem,11.5vw,3.2rem)}
    .gi-hero .h1-sub{font-size:clamp(1.2rem,5vw,1.5rem)}
    .gi-hero-lead{font-size:clamp(1rem,3.8vw,1.08rem);margin-top:16px}
    .gi-hero .hero-actions{margin-top:22px}
    .gi-hero .hero-actions .btn{width:100%;justify-content:center}
    .hero-seelink{
      display:inline-flex;align-items:center;
      min-height:44px;padding:8px 0;margin-top:12px;
    }

    .gi-what-split .split-txt,
    .gi-what-media{padding-left:22px;padding-right:22px}
    .gi-what-split .title{font-size:clamp(1.85rem,8vw,2.4rem)}
    .gi-what-split .body{font-size:1.02rem}

    .gi-benefits-head h2{font-size:clamp(1.85rem,8vw,2.4rem)}
    .bcard-body{padding:clamp(22px,5vw,28px)}
    .beyebrow{margin-bottom:12px}
    .bbody{font-size:.98rem}

    .quoteband{padding:clamp(56px,12vw,96px) 0}
    .quoteband-title{font-size:clamp(1.3rem,5.2vw,1.5rem)}
    .quoteband-q{font-size:clamp(1.32rem,5.4vw,1.6rem)}
    .quoteband-cite{font-size:.95rem}

    .become-content{padding-left:22px;padding-right:22px}
    .become-title{font-size:clamp(2rem,9vw,2.4rem)}
    .become-body,.become-sub{font-size:1rem}
    .become-split .tier{
      gap:12px 14px;
      padding:16px 16px;
      align-items:flex-start;
    }
    .become-split .tier .amt{font-size:1.45rem;min-width:4.6ch}
    .become-split .tier .tdesc{font-size:.88rem}
    .tier-note{font-size:.92rem}
    .become-photo{min-height:min(48vh,360px)}
    .gi-donate-photo{min-height:min(42vh,320px)}
    .gi-donate-panel{padding:clamp(28px,5vw,48px) 22px}
    .taxline{font-size:.7rem}

    .gi-other .title{font-size:clamp(1.85rem,8vw,2.4rem)}
  }


  /* selectable Homeroom tiers */
  .become-split .tier{cursor:pointer;text-align:left;font:inherit;width:100%;appearance:none;-webkit-appearance:none;position:relative}
  .become-split .tier:focus-visible{outline:3px solid var(--teal);outline-offset:3px}
  .become-split .tier.is-selected{
    box-shadow:0 0 0 2px currentColor, 0 10px 28px -18px rgba(2,55,79,.35);
    transform:translateX(5px);
  }
  .become-split .tier-1.is-selected{box-shadow:0 0 0 2px var(--v-deep), 0 10px 28px -18px rgba(2,55,79,.35)}
  .become-split .tier-2.is-selected{box-shadow:0 0 0 2px var(--v-teal2), 0 10px 28px -18px rgba(2,55,79,.35)}
  .become-split .tier-3.is-selected{box-shadow:0 0 0 2px var(--v-mint2), 0 10px 28px -18px rgba(2,55,79,.35)}

</style>

<script>
  import { trackEvent } from '../scripts/analytics.js';

  const group = document.querySelector('.become-split .tiers');
  const cta = document.querySelector('.become-split [data-join="homeroom"]');
  if (group && cta) {
    const tiers = [...group.querySelectorAll('.tier')];
    const urlFor = (amount) =>
      group.getAttribute(`data-tier-${amount}`) || '';

    /** Interim path: homepage Keela General Donation Form with selected monthly amount. */
    const homepageDonate = (amount) =>
      `/?amount=${amount}&frequency=monthly#homeroom`;

    function selectTier(btn) {
      tiers.forEach((t) => {
        const on = t === btn;
        t.classList.toggle('is-selected', on);
        t.setAttribute('aria-checked', on ? 'true' : 'false');
      });
      const amount = btn.getAttribute('data-amount') || '100';
      cta.setAttribute('data-selected-amount', amount);
      const tierUrl = urlFor(amount);
      const href = tierUrl || homepageDonate(amount);
      cta.setAttribute('href', href);
      if (href.startsWith('http')) {
        cta.setAttribute('target', '_blank');
        cta.setAttribute('rel', 'noopener');
      } else {
        // Same-site deep link to homepage form — stay in this tab
        cta.removeAttribute('target');
        cta.removeAttribute('rel');
      }
    }

    tiers.forEach((btn) => {
      btn.addEventListener('click', () => selectTier(btn));
      btn.addEventListener('keydown', (e) => {
        if (e.key !== 'ArrowDown' && e.key !== 'ArrowUp') return;
        e.preventDefault();
        const i = tiers.indexOf(btn);
        const next = e.key === 'ArrowDown'
          ? tiers[(i + 1) % tiers.length]
          : tiers[(i - 1 + tiers.length) % tiers.length];
        next.focus();
        selectTier(next);
      });
    });

    // Sync CTA to the pre-selected tier (Visionary $100 by default)
    const initiallySelected = group.querySelector('.tier.is-selected') || tiers[tiers.length - 1];
    if (initiallySelected) selectTier(initiallySelected);

    cta.addEventListener('click', () => {
      trackEvent('cta_homeroom_click', {
        source: 'give_become',
        amount: cta.getAttribute('data-selected-amount') || '100',
      });
    });
  }
</script>

  .taxline{font-size:.72rem;line-height:1.55;color:var(--v-ink);opacity:.7;
    max-width:none;text-align:center;text-wrap:pretty}

  /* ---------- DONATE SPLIT (photo-left + Keela on blue) ---------- */
  .gi-donate-split{
    display:grid;grid-template-columns:1fr 1fr;align-items:stretch;
    min-height:clamp(640px,82vh,940px);position:relative;overflow:hidden;

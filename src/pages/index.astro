---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import WhySplit from '../components/WhySplit.astro';
import StatBand from '../components/StatBand.astro';
import VoiceBand from '../components/VoiceBand.astro';
import InviteBand from '../components/InviteBand.astro';
import OrbitSection from '../components/OrbitSection.astro';
import CommunityCircles from '../components/CommunityCircles.astro';
import Pillars from '../components/Pillars.astro';
import HomeroomBlock from '../components/HomeroomBlock.astro';
import DoorCards from '../components/DoorCards.astro';
import NewsletterForm from '../components/NewsletterForm.astro';

const organizationSchema = {
  '@context': 'https://schema.org',
  '@type': 'NGO',
  name: 'The Contentment Foundation',
  url: 'https://www.contentment.org',
  logo: 'https://www.contentment.org/assets/logo_lockup_light.svg',
  description: 'We equip teachers with evidenced wellbeing practices.',
  foundingDate: '2016',
  areaServed: 'Worldwide',
  sameAs: [
    'https://www.instagram.com/contentmentorg/',
  ].filter(url => url), // Filter out empty social links
};
---
<BaseLayout
  keela
  title="The Contentment Foundation"
  description="We equip teachers with evidenced wellbeing practices. 325 schools. 12 countries. 86% of educators report real improvement. Join from $25/month."
  ogImage="/assets/logo_lockup_light.svg"
  ogType="organization"
>
  <script type="application/ld+json" set:html={JSON.stringify(organizationSchema)} />
  <Hero />
  <WhySplit />
  <StatBand />
  <VoiceBand />
  <InviteBand />
  <OrbitSection />
  <CommunityCircles />
  <Pillars />
  <HomeroomBlock />
  <DoorCards />
  <!-- FEAT-070: → Flodesk segment "www.contentment.org" (FLODESK_SEGMENT_WWW). -->
  <NewsletterForm source="homepage_newsletter_band" />
</BaseLayout>

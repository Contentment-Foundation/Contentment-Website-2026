---
// Why Teacher Wellbeing — migrated verbatim from Dave's Jul 29 2026 handoff:
// handoff/2026-07-29-dave-pages/2_WHY WELLBEING/why-wellbeing-assets/why-wellbeing.html
// (the de-inlined form, per HANDOFF-why-wellbeing.md §7 — canonical repo copy).
// See docs/planning/TECHNICAL-ARCHITECTURE.md §3 — no redesign, structure/CSS copied as-is.
// Shared <Nav />/<Footer /> replace this page's own header/footer markup (deleted per
// migration hard rules); nav/footer seams are wired centrally in src/config/seams.ts.
import BaseLayout from '../layouts/BaseLayout.astro';
import KeelaDonateForm from '../components/KeelaDonateForm.astro';

// TICKET-020 acceptance — "Share button triggers Web Share API or copy-link fallback"
// (FEATURE-TICKETS.md:166), and MESSAGING-AND-COPY.md's /why spec: "Secondary CTA: Share
// this page." Gap logged in the 4 Aug audit. Same seam shape as /about (about.astro:17-19)
// with /why-specific copy. shareUrl matches this page's OWN canonical exactly — BaseLayout
// renders `new URL(Astro.url.pathname, Astro.site)` and Astro's directory build emits
// dist/why/index.html, so canonical and og:url both carry the trailing slash.
// The mailto href is the no-JS floor and the handler's last-resort tier; everything else is
// read off data-* so the rendered link and the script can never drift apart.
const shareUrl = 'https://www.contentment.org/why/';
const shareSubject = 'Why teacher wellbeing? This page answers it.';
const shareText = 'This is why we put teachers first, and how you can too.';
const shareBody = `${shareText} Start here: ${shareUrl}`;
const shareMailto = `mailto:?subject=${encodeURIComponent(shareSubject)}&body=${encodeURIComponent(shareBody)}`;
---
<BaseLayout
  title="Why Teacher Wellbeing Matters — TCF"
  description="Teacher burnout is a children problem, a future problem. See the Harvard research, the 86% outcome, and why teacher wellbeing is the antidote."
>

<!-- 1 - HERO with CEO video -->
<section class="hero" id="top">
  <div class="hero-bg" style="background-image:url('/assets/why-hero-bg.jpg');background-size:cover;background-position:62% 30%"></div>
  <div class="hero-bg mob" style="background-image:url('/assets/why-hero-bg.jpg');background-size:cover;background-position:70% 24%"></div>
  <div class="hero-inner wrap">
    <div class="hero-content">
      <h1 class="hero-q">
        <span class="l1 anim">Teacher wellbeing?</span>
        <span class="l2 anim d1">With everything going on in the world?</span>
        <span class="l3 anim d2"><em>This page is why we put teachers first, and how you can too.</em></span>
      </h1>
    </div>
  </div>
  <div class="scrollcue"><span class="dot"></span></div>
</section>

<!-- 2 - THE ACTUAL JOB (real teacher voice) -->
<section class="band jobdef">
  <div class="wrap">
    <div class="anim">
      <h2 class="title">The job description says: <span class="script">teach.</span></h2>
      <p class="lead">But it's so much more than that.</p>
    </div>
    <div class="jd-videowrap anim d1">
      <button class="jd-video" data-yt="OZsgO23XFj0" aria-label="Play: a one minute message from our CEO">
        <span class="hv-poster" style="background-image:url('/assets/why-play-ceo-message.jpg')"></span>
        <span class="hv-play" aria-hidden="true"></span>
      </button>
      <div class="jd-doodle" aria-hidden="true"><img src="/assets/why-jd-doodle.png" alt=""><span>Watch the 1-minute message from our CEO.</span></div>
    </div>
    <figure class="teacher-quote anim d2">
      <div class="tq-photo"><img src="/assets/why-tq-photo.jpg" alt="Jahar Van"></div>
      <div class="tq-body">
        <blockquote>&#8220;You have kids that live in a shelter, you don't know if these kids ate. You don't know what his parents went through last night. And then they get in a classroom after all that&#8230;&#8221;</blockquote>
        <figcaption><b>Jahar Van</b> &middot; Counselor, PS/MS-124, Queens NY</figcaption>
      </div>
    </figure>
    <div class="jd-close anim d2">
      <p>A teacher's wellbeing does not stop with one adult. It shapes the classroom, reaches every child, and beyond, to their families and communities over time.</p>
      <p>Before any lesson is taught, children are reading the human being in front of them.</p>
    </div>
    <p class="jd-pivot anim d2">Tend to the <span class="script">teacher</span>, and you reach every child they will ever teach.</p>
  </div>
</section>

<!-- 3 - FOLD A: the argument. Photo right, panel left. -->
<section class="band leverage" id="leverage">
  <div class="lev-inner">
  <div class="lev-shot" style="background-image:url('/assets/why-lev-shot.jpg')" role="img" aria-label="A teacher leaning in, listening closely to a student at her desk"></div>
  <div class="lev-panel">
    <div class="lev-pin anim">
      <h2 class="title">Teachers are one of the highest-leverage points in a child's life.</h2>
      <p class="body">One thriving teacher shapes the entire room, influences a whole school's culture, and reaches thousands of students over a career. That's why we begin with the adults.</p>
      <p class="body">When a teacher has room to breathe, to notice, to return to themselves, every child in that room feels it.</p>
    </div>
  </div>
  </div>
</section>

<!-- 4 - FOLD B: the proof. Stats on white texture. -->
<section class="band proof" id="evidence">
  <div class="wrap">
    <div class="proof-head">
      <div class="anim">
        <h2 class="title">This is not a hunch. It is one of the best-documented ways to <span class="script">change education.</span></h2>
        <p class="proof-harvard">Harvard's Graduate School of Education found what teachers always knew: ease a teacher's stress, and children's early skills improve, with gains still visible years later.</p>
      </div>
      <figure class="proof-photo anim d1"><img src="/assets/why-proof-photo.jpg" alt="A teacher and her students laughing together in a school courtyard in Bhutan"></figure>
    </div>
    <div class="stats">
      <div class="stat anim"><div class="rnum">86%<span class="plus">+</span></div><div class="lab">improved in wellbeing, relationships, and classroom (2025, four regions)</div></div>
      <div class="stat anim d1"><div class="rnum">90%<span class="plus">+</span></div><div class="lab">of 200 counselors in Bhutan's retreats had burnout directly addressed</div></div>
      <div class="stat anim d2"><div class="rnum">9 in 10</div><div class="lab">partner schools in Hawaiʻi chose to keep going</div></div>
      <div class="stat anim d3"><div class="rnum">National</div><div class="lab">supporting the Ministry of Education's work with school counselors across Bhutan</div></div>
    </div>
  </div>
</section>

<!-- 5 - WHY NOW + TEACHER VIDEOS -->
<section class="band whynow" style="background:#008cb8 url('/assets/why-darkblue-texture.jpg') center/cover">
  <div class="wrap">
    <div class="wn-grid">
      <div class="wn-head anim">
        <h2>This has never mattered more, and the reason is in every student's pocket.</h2>
      </div>
      <div class="wn-body anim d1">
        <p>Any answer, instantly. If school were only about moving facts into kids' heads, the machines would already have the job. But school was never only that.</p>
        <span class="turn">The most valuable thing in a classroom now is the one thing no technology can fake: a present, grounded, human adult.</span>
      </div>
    </div>
    <div class="wn-videos anim d2">
      <span class="eyebrow">Teachers, in their own words</span>
      <div class="reels">
        <div class="reel anim"><div class="vframe vert" data-yt="-9EAmpgkZ5w" data-inline="1" role="button" tabindex="0" aria-label="Play: Vincent Birisi"><div class="poster" style="background-image:url('/assets/why-play-vincent-birisi.jpg')"></div><div class="vscrim"></div><div class="play"></div></div><div class="rname">Vincent Birisi<i>Teacher, Oloolaiser High School, Kenya</i></div></div>
        <div class="reel anim d1"><div class="vframe vert" data-yt="Q86tC-AaJQc" data-inline="1" role="button" tabindex="0" aria-label="Play: Tim Huang"><div class="poster" style="background-image:url('/assets/why-play-tim-huang.jpg')"></div><div class="vscrim"></div><div class="play"></div></div><div class="rname">Tim Huang<i>Teacher, ELC High School, Bhutan</i></div></div>
        <div class="reel anim d2"><div class="vframe vert" data-yt="WtC8tA2PCtw" data-inline="1" role="button" tabindex="0" aria-label="Play: Sheyenne Keliʻikuli"><div class="poster" style="background-image:url('/assets/why-play-sheyenne-keliikuli.jpg')"></div><div class="vscrim"></div><div class="play"></div></div><div class="rname">Sheyenne Keliʻikuli<i>Teacher, Kaʻŭmeke Kāʻeo Charter School, Hawaiʻi</i></div></div>
      </div>
    </div>
  </div>
</section>

<!-- 6 - OBJECTIONS -->
<section class="band objsec">
  <div class="wrap">
    <div class="obj-head anim">
      <h2 class="title">You might be weighing this against other causes. Good.</h2>
    </div>
    <div class="qa anim d1">
      <div class="qa-item">
        <button class="qa-q" aria-expanded="false"><span>What about child poverty?</span><span class="qi" aria-hidden="true">+</span></button>
        <div class="qa-a"><p>Walk into the schools we serve in New York City, Kenya, Uganda, Tanzania, and the DRC. Teachers there stand at the front line of student needs shaped by poverty. When those teachers are restored, the children have the presence of one grown-up standing between them and everything else. Teacher wellbeing <em>is</em> child-poverty work, one step closer to the source, where supporting a single adult reaches a whole classroom at once.</p></div>
      </div>
      <div class="qa-item">
        <button class="qa-q" aria-expanded="false"><span>What about youth mental health?</span><span class="qi" aria-hidden="true">+</span></button>
        <div class="qa-a"><p>A struggling student's first responder is not a therapist. It is a teacher. One Hawaiʻi educator told us the Four Pillars saved his life, personally and professionally, and that he can now help his students meet fear and grief <em>with success and grace</em>. Equip one teacher, and you have placed a wellbeing practitioner in front of every child in the room, all year.</p></div>
      </div>
      <div class="qa-item">
        <button class="qa-q" aria-expanded="false"><span>Honestly? I'm burned out too.</span><span class="qi" aria-hidden="true">+</span></button>
        <div class="qa-a"><p>Then you understand this cause better than anyone. You know what it costs to keep showing up empty, and what one person's genuine support can change. That is what Homeroom is: people who know the weight, lifting it together, and being lifted too. This is for you too.</p></div>
      </div>
    </div>
    <p class="qa-still anim d2" style="margin-top:clamp(34px,4vw,64px)">Still curious? <a href="mailto:hello@contentment.org">Email our team</a> (<a href="mailto:hello@contentment.org">hello@contentment.org</a>), a real person answers.</p>
  </div>
</section>

<!-- 7 - GIVING (the one ask) -->
<section class="band homeroom" id="give" style="--dbtex:url('/assets/why-darkblue-texture.jpg')">
  <div class="homeroom-img" role="img" aria-label="A teacher helping two students" style="background-image:url('/assets/why-teacher-helping-two-students.jpg');background-size:cover;background-position:center 26%"></div>
  <div class="homeroom-panel">
    <div class="homeroom-inner">
      <div class="homeroom-head anim">
        <span class="eyebrow">Where your gift goes</span>
        <h2 class="title">Tend to the teacher, and you reach every child.</h2>
        <p>Since 2016, the 11,925 educators we have walked alongside have carried this work to more than 409,000 students. Certifying one educator costs about $1,200 over a year.</p>
      </div>
      <!-- Keela General Donation Form (seams.keela.generalDonationForm). India + per-tier deferred. -->
      <div class="keela-slot anim">
        <KeelaDonateForm source="why_homeroom_block" />
      </div>
      <div class="homeroom-cta anim d1">
        <span class="fine">Cancel anytime. Gifts are unrestricted.</span>
        <p class="legal">Contentment Foundation is a 501(c)(3) nonprofit (EIN 47-5432756), and your contributions are tax-deductible to the extent permitted by law. Thank you for being part of this work.</p>
      </div>
      <!-- TICKET-020 secondary CTA — "Primary CTA: Join Homeroom. Secondary: Share this page."
           Sits AFTER .homeroom-cta so "Cancel anytime" stays adjacent to the Keela form it
           describes. Uses the global .btn/.btn-ghost component (global.css:15,18-19) — the
           same pairing schools.astro and 404.astro use on dark bands. /about's .cbtn is
           page-scoped and would render unstyled here. Caption echoes /about's approved
           Pass-it-On line (about.astro:150) rather than inventing new copy. -->
      <div class="give-share anim d2">
        <span class="fine">Can&#8217;t give today? Showing this to someone who loves a teacher helps too.</span>
        <a
          class="btn btn-ghost"
          href={shareMailto}
          data-share-page
          data-share-url={shareUrl}
          data-share-title={shareSubject}
          data-share-text={shareText}
        >Share this page</a>
        <span class="share-status" data-share-status role="status" aria-live="polite"></span>
      </div>
    </div>
  </div>
</section>

<!-- NEWSLETTER — buffer between the Giving blue and the shared footer blue -->
<section class="band-tight news">
  <div class="wrap news-inner">
    <div class="anim">
      <h2 class="title">Something <span class="script">meaningful</span> for your inbox.</h2>
      <p class="body">Here you'll discover open-hearted stories, useful wellbeing practices, and invitations to help build a more caring future for education. No spam, no noise.</p>
    </div>
    <!-- FEAT-070: → Flodesk segment "www.contentment.org" (FLODESK_SEGMENT_WWW). -->
    <form class="anim d1" data-newsletter="why_page">
      <div class="row">
        <input type="text" name="first_name" placeholder="First name" aria-label="First name" autocomplete="given-name">
        <input type="email" name="email" placeholder="Email address" aria-label="Email address" autocomplete="email" required>
      </div>
      <input type="text" name="company" class="nl-hp" tabindex="-1" autocomplete="off" aria-hidden="true">
      <button class="btn btn-primary news-btn" type="submit">Send me something meaningful</button>
      <p class="nl-status" data-newsletter-status role="status" aria-live="polite"></p>
    </form>
  </div>
</section>

<div class="lb" id="lb" role="dialog" aria-modal="true" aria-label="Video">
  <div class="lb-inner"><button class="lb-close" id="lbClose" aria-label="Close">&#215;</button><div id="lbSlot" class="lb-video"></div></div>
</div>

</BaseLayout>

<style>
  /* Page-specific CSS only — reset/wrap/eyebrow/buttons/nav/footer/.anim/section-typography
     system are already in src/styles/global.css (verified identical, see TECHNICAL-ARCHITECTURE §3).
     This page's sections that reuse a shared "kit" selector name (.hero, .homeroom, .news, .stats)
     but need different property values are kept here — Astro scopes page <style> blocks to this
     page's own markup, so these overrides cannot leak onto Home's identical class names.
     Sections from Dave's kit boilerplate that this page doesn't actually use (.impact, .split,
     .how-orbit, .alone/.circles, .pillars, .doors, .tiers, .stmt, .signoff, .tldr) are omitted —
     dead CSS, no matching markup on this page. */

  /* hero: page-specific gradient + question layout (differs from Home's hero) */
  .hero::after{content:"";position:absolute;inset:0;background:linear-gradient(105deg,rgba(0,80,110,.9) 0%,rgba(0,144,190,.6) 34%,rgba(0,144,190,.22) 62%,rgba(0,144,190,.1) 100%)}
  .hero h1 em{font-style:italic;color:#bfeef5}
  .hero-q{display:flex;flex-direction:column;gap:.32em;font-family:var(--display);color:#fff;letter-spacing:-.01em;line-height:1.08;text-shadow:0 2px 24px rgba(2,40,58,.35)}
  .hero-q .l1{font-size:clamp(2.6rem,5.35vw,4.6rem);font-weight:500}
  .hero-q .l2{font-size:clamp(1.4rem,2.45vw,2.1rem);font-weight:400;color:rgba(255,255,255,.9)}
  .hero-q .l3{font-size:clamp(1.4rem,2.45vw,2.1rem);font-weight:400;margin-top:.4em}
  .hero-q .l3 em{font-style:italic;color:#bfeef5}
  .hero .hero-inner{max-width:clamp(1240px,86vw,2040px)}
  .hero .hero-content{max-width:clamp(720px,52vw,760px)}
  @media(min-width:561px) and (max-width:1240px){.hero .wrap{padding-left:clamp(40px,5.5vw,64px);padding-right:clamp(40px,5.5vw,64px)}}
  @media(max-width:560px){.hero::after{background:linear-gradient(180deg,rgba(2,40,58,.5) 0%,rgba(2,46,66,.15) 35%,rgba(2,40,58,.9) 100%)}}

  /* merged "the teacher" beat */
  .jobdef{background:#e8e8e8 url('/assets/why-white-texture.jpg') center/cover}
  .jobdef .wrap{max-width:1120px}
  .jobdef .lead{margin-top:14px;max-width:62ch;font-family:var(--display);font-style:italic;font-weight:400;font-size:clamp(1.3rem,2.2vw,1.75rem);color:var(--deep);letter-spacing:-.005em}
  .jobdef .title{margin-top:20px}
  .jd-pivot{font-family:var(--display);font-weight:500;font-size:clamp(1.5rem,2.6vw,2.1rem);color:var(--deep);line-height:1.28;margin-top:34px;max-width:none}
  .jd-videowrap{position:relative;margin-top:34px}
  .jd-video{position:relative;display:block;padding:0;width:min(100%,906px);aspect-ratio:16/9;border-radius:14px;overflow:hidden;border:1px solid rgba(2,78,112,.22);cursor:pointer;box-shadow:0 18px 46px -20px rgba(2,30,44,.55);background:#02374f}
  .jd-video .hv-poster{position:absolute;inset:0;background-size:cover;background-position:center;transition:.5s}
  .jd-video:hover .hv-poster{transform:scale(1.04)}
  .jd-video .hv-play{position:absolute;top:50%;left:50%;transform:translate(-50%,-50%);width:62px;height:62px;border-radius:50%;background:rgba(255,255,255,.94);display:grid;place-items:center;box-shadow:0 6px 20px rgba(2,30,44,.35)}
  .jd-video .hv-play::before{content:"";width:0;height:0;border-style:solid;border-width:10px 0 10px 17px;border-color:transparent transparent transparent var(--deep);margin-left:4px}
  .jd-doodle{position:absolute;top:50%;transform:translateY(-50%);left:calc(min(100%,906px) + 24px);width:clamp(190px,15vw,250px);display:none;place-items:center}
  .jd-doodle img{width:100%;height:auto;display:block}
  .jd-doodle span{position:absolute;top:42%;left:50%;transform:translate(-50%,-50%);width:70%;text-align:center;font-family:'Varela Round',var(--body);text-transform:uppercase;letter-spacing:.04em;line-height:1.34;font-size:clamp(.72rem,.88vw,.88rem);color:var(--deep)}
  @media(min-width:1360px){.jd-doodle{display:grid}}
  .teacher-quote{margin:36px 0 0;max-width:720px;display:flex;gap:24px;align-items:center}
  .tq-photo{flex:0 0 auto;width:118px;height:118px;border-radius:14px;overflow:hidden}
  .tq-photo img{width:100%;height:100%;object-fit:cover;object-position:center 38%;display:block}
  .tq-body blockquote{font-family:var(--display);font-style:italic;font-weight:500;font-size:clamp(1.08rem,1.6vw,1.38rem);line-height:1.44;color:var(--deep);letter-spacing:-.005em}
  .tq-body figcaption{margin-top:12px;font-size:.86rem;color:var(--slate)}
  .tq-body figcaption b{color:var(--deep)}
  @media(max-width:640px){.teacher-quote{gap:18px}}
  @media(max-width:480px){.teacher-quote{flex-direction:column;align-items:flex-start}.tq-photo{width:84px;height:84px}}
  .jd-close{margin-top:34px}
  .jd-close p{font-size:clamp(1.05rem,1.4vw,1.2rem);color:var(--slate);line-height:1.62;max-width:820px;text-wrap:pretty}
  .jd-close p+p{margin-top:1em}
  .jobdef .script{font-family:var(--script);font-style:normal;font-size:1.02em;line-height:1.15;display:inline-block;padding:0 .06em}

  /* FOLD A - the argument */
  .leverage{padding:0;background:#53b591 url('/assets/why-green-texture.jpg') center/cover}
  .lev-inner{max-width:1760px;margin:0 auto;display:grid;grid-template-columns:minmax(0,58%) minmax(0,42%);min-height:clamp(620px,44vw,900px)}
  .lev-shot{order:2;background-size:cover;background-position:center}
  .lev-panel{order:1;display:flex;flex-direction:column;justify-content:center;align-items:flex-start;position:relative;overflow:hidden;
    padding-top:clamp(56px,6vw,96px);padding-bottom:clamp(56px,6vw,96px);
    padding-left:min(352px, max(32px, calc((100vw - 1120px)/2 + 32px)));
    padding-right:clamp(48px,5vw,110px)}
  .lev-panel::after{content:"";position:absolute;width:520px;height:520px;border-radius:50%;border:1px solid rgba(255,255,255,.15);right:-215px;bottom:-235px}
  .lev-pin{position:relative;z-index:1;width:100%}
  .leverage .title{color:#fff;margin:0 0 clamp(22px,2vw,34px)}
  .leverage .body{color:rgba(255,255,255,.92);margin:0 0 clamp(18px,1.5vw,26px);max-width:60ch}
  .leverage .body:last-child{margin-bottom:0}
  @media(max-width:860px){
    .lev-inner{grid-template-columns:1fr;min-height:0}
    .lev-shot{order:1;aspect-ratio:4/5}
    .lev-panel{order:2;padding-left:32px}
  }
  @media(max-width:560px){.lev-panel{padding-left:22px;padding-right:22px}}

  /* FOLD B - the proof */
  .proof{background-color:#e8e8e8;background-image:url('/assets/why-white-texture.jpg');background-size:cover;background-position:center}
  .proof .wrap{max-width:1120px}
  .proof .title{color:#26929d;max-width:22ch;margin:0}
  .proof-harvard{margin-top:22px;color:var(--slate);font-size:1.05rem;line-height:1.62;max-width:60ch}
  .proof-head{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,38%);gap:clamp(28px,4vw,64px);align-items:start}
  .proof-photo{margin:0;border-radius:14px;overflow:hidden;box-shadow:0 16px 40px -18px rgba(2,30,44,.34)}
  .proof-photo img{width:100%;display:block}
  @media(min-width:1700px){.proof-photo{width:calc(100% + min(300px, 12vw));margin-right:calc(-1 * min(300px, 12vw))}}
  @media(max-width:860px){.proof-head{grid-template-columns:1fr;gap:26px}.proof-photo{max-width:520px}}
  .proof .stats{margin-top:48px;border-top:1px solid rgba(2,78,112,.18);padding-top:40px}
  /* .rnum, not .num: these aren't count-up numbers (86%, "9 in 10", "National" have no
     data-count and can't be animated as integers) — BaseLayout's shared initCountUp()
     selects .num globally and would overwrite each one with "NaN" on scroll-into-view.
     Same fix as our-impact/index.astro's .rnum; font/size match global.css's .stat .num. */
  .proof .stat .rnum{font-family:var(--display);font-weight:500;font-size:clamp(2.4rem,4.5vw,3.6rem);line-height:1;letter-spacing:-.005em;color:#26929d}
  .proof .stat .rnum .plus{color:var(--green)}
  .proof .stat .lab{color:var(--slate)}

  /* why now + teacher videos (one blue band) */
  .whynow{position:relative;overflow:hidden}
  .whynow::before{content:"";position:absolute;width:600px;height:600px;border-radius:50%;border:1px solid rgba(255,255,255,.06);top:-220px;right:-160px;animation:rippleA 27s ease-in-out -4s infinite;will-change:transform,opacity}
  .whynow .wrap{max-width:1120px;position:relative;z-index:2}
  .wn-grid{display:block;max-width:980px}
  .wn-head h2{font-family:var(--display);font-weight:500;font-size:clamp(2rem,4vw,3.3rem);line-height:1.08;color:#fff;letter-spacing:-.005em;text-wrap:balance}
  .wn-body{margin-top:26px}

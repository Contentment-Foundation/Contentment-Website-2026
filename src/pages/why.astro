  /* lightbox (CEO video + reel fallback) */
  .lb{position:fixed;inset:0;background:rgba(2,28,42,.9);display:none;place-items:center;z-index:200;padding:26px;backdrop-filter:blur(6px)}
  .lb.open{display:grid}
  .lb-inner{width:min(1080px,92vw);position:relative}
  .lb-video{position:relative;width:100%;height:0;padding-top:56.25%;border-radius:14px;overflow:hidden;background:#000}
  .lb-video iframe{position:absolute;inset:0;width:100%;height:100%;border:0}
  .lb-close{position:absolute;top:-48px;right:0;background:none;border:1px solid rgba(255,255,255,.55);color:#fff;border-radius:50%;width:40px;height:40px;cursor:pointer;font-size:1.3rem;line-height:1}
</style>

<script>
  // Page-specific behaviour not covered by src/scripts/*: accordion + video lightbox/inline-play.
  // Ported verbatim from why-wellbeing.html's inline <script> (nav scroll, hero entrance, reveal-on-
  // scroll, count-up are already handled globally by BaseLayout's animations.js/nav.js).
  import { initNewsletterForms } from '../scripts/newsletter.js';
  import { youtubeIframeHtml, createYoutubeIframe } from '../scripts/youtube-embed.js';
  import { attachLightboxA11y } from '../scripts/lightbox-a11y.js';
  import { trackEvent } from '../scripts/analytics.js';

  // FEAT-070 — "Send me something meaningful" → Flodesk segment "www.contentment.org".
  initNewsletterForms();

  document.querySelectorAll('.qa-item').forEach((item) => {
    const b = item.querySelector('.qa-q');
    b?.addEventListener('click', () => {
      const open = item.classList.toggle('open');
      b.setAttribute('aria-expanded', String(open));
    });
  });

  const lb = document.getElementById('lb');
  const lbSlot = document.getElementById('lbSlot');
  const lbClose = document.getElementById('lbClose');

  // Focus management for the cross-origin YouTube frame — see lightbox-a11y.js.
  // The old `window`-scoped Escape handler could never fire once focus was inside
  // the player, which made this a real keyboard trap (WCAG 2.1.2 A).
  const lbA11y = attachLightboxA11y(lb!, lbClose!, () => closeLb());

  function openLb(id: string, trigger?: HTMLElement) {
    if (!lbSlot || !lb) return;
    lbSlot.innerHTML = youtubeIframeHtml(id);
    lb.classList.add('open');
    lbA11y.opened(trigger);
  }
  function closeLb() {
    if (!lbSlot || !lb) return;
    lb.classList.remove('open');
    lbSlot.innerHTML = '';
    lbA11y.closed();
  }
  // data-inline reels play in place (one click, playsinline stops iOS hijacking to fullscreen).
  function playInline(el: HTMLElement) {
    const id = el.dataset.yt;
    if (!id) return;
    el.replaceChildren(createYoutubeIframe(id, { title: 'Teacher video' }));
    el.removeAttribute('role');
    el.removeAttribute('tabindex');
    el.style.cursor = 'default';
    el.classList.add('is-playing');
  }
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    const go = () => (el.dataset.inline ? playInline(el) : openLb(el.dataset.yt as string, el));
    el.addEventListener('click', go);
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); go(); }
    });
  });
  lbClose?.addEventListener('click', closeLb);
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });

  // TICKET-020 acceptance — "Share button triggers Web Share API or copy-link fallback".
  // Analytics contract matches /about's [data-share-email] handler (about.astro:193-215):
  // trackEvent('content_shared', { method, source }). Only source differs ('why_page');
  // 'copy_link' is the new middle tier, so the criterion's literal "copy-link fallback"
  // wording is met — /about only ever fires native_share / email.
  // Tiers: Web Share -> clipboard copy -> mailto navigation.
  // The mailto tier carries /about's Chromium workaround: empty-To `mailto:?` links often
  // no-op once the click is handled in JS, so navigate explicitly after preventDefault().
  // That same href is what keeps the control working with JS disabled.
  // Copy and URL come off data-* (the dataset pattern this file already uses for [data-yt])
  // so the frontmatter consts stay the single source and cannot drift from the rendered mailto.
  document.querySelectorAll<HTMLAnchorElement>('[data-share-page]').forEach((el) => {
    const status = el.closest('.give-share')?.querySelector<HTMLElement>('[data-share-status]');
    const url = el.dataset.shareUrl || location.href;
    const title = el.dataset.shareTitle || document.title;
    const text = el.dataset.shareText || '';

    el.addEventListener('click', async (e) => {
      const href = el.getAttribute('href') || '';

      e.preventDefault();

      if (typeof navigator.share === 'function') {
        try {
          await navigator.share({ title, text, url });
          trackEvent('content_shared', { method: 'native_share', source: 'why_page' });
        } catch {
          /* user cancelled the share sheet — leave quietly, same as /about */
        }
        return;
      }

      if (typeof navigator.clipboard?.writeText === 'function') {
        try {
          await navigator.clipboard.writeText(url);
          trackEvent('content_shared', { method: 'copy_link', source: 'why_page' });
          if (status) {
            status.textContent = 'Link copied.';
            setTimeout(() => { status.textContent = ''; }, 4000);
          }
          return;
        } catch {
          /* clipboard blocked (insecure origin / denied permission) — fall through to mailto */
        }
      }

      trackEvent('content_shared', { method: 'email', source: 'why_page' });
      window.location.href = href;
    });
  });
</script>

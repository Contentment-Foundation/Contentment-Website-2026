  .qa-q .qi{flex:0 0 auto;width:32px;height:32px;border-radius:50%;border:1.5px solid var(--teal);color:var(--ocean);display:grid;place-items:center;font-size:1.15rem;line-height:1;transition:transform .4s,background .3s,color .3s}

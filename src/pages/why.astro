     file rather than "fixed", per the no-redesign migration rule. */
  .homeroom{display:grid;grid-template-columns:0.92fr 1.08fr;align-items:stretch;min-height:clamp(640px,82vh,940px);color:#fff;position:relative;overflow:hidden;background:#008cb8}

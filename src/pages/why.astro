  .qa-still a{color:var(--deep);font-weight:600;text-decoration:underline;text-decoration-thickness:1.5px;text-underline-offset:3px;transition:color .25s}
  .qa-still a:hover{color:var(--ocean)}

  /* 7 - GIVING band. Note: .homeroom-panel's first rule below carries !important on a
     texture background var; the second (non-!important) linear-gradient rule that follows

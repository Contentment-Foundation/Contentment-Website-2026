---
/**
 * FEAT-002 — branded 404.
 * Netlify serves dist/404.html for unmatched routes with a real 404 status.
 * Layout aligned with /privacy + /updates utility pattern (short deep gradient
 * hero, paper band, shared tokens). No new design language.
 */
import BaseLayout from '../layouts/BaseLayout.astro';

const DESTINATIONS = [
  { href: '/', label: 'Home', blurb: 'Start from the beginning' },
  { href: '/why', label: 'Why Teacher Wellbeing', blurb: 'The case for this work' },
  { href: '/our-impact', label: 'Our Impact', blurb: 'Stories and results' },
  { href: '/schools', label: 'For Schools', blurb: 'How we partner with you' },
  { href: '/events', label: 'Events', blurb: "What's coming up" },
  { href: '/getinvolved', label: 'Get Involved', blurb: 'Support a teacher' },
  { href: '/updates', label: 'Updates', blurb: 'Stories to your inbox' },
  { href: '/about', label: 'About', blurb: 'Who we are' },
];
---
<BaseLayout
  title="Page Not Found | The Contentment Foundation"
  description="That page doesn't exist — but there's plenty else here. Explore teacher wellbeing resources, impact stories, and ways to get involved."
>
  <meta slot="head" name="robots" content="noindex, follow" />

  <section class="nf-hero" id="top">
    <div class="nf-motif" aria-hidden="true">
      <svg viewBox="0 0 200 200" fill="none" xmlns="http://www.w3.org/2000/svg">
        <circle class="nf-ring" cx="100" cy="100" r="70" />
        <circle class="nf-ring nf-ring--mid" cx="100" cy="100" r="48" />
        <circle class="nf-ring nf-ring--in" cx="100" cy="100" r="26" />
        <path class="nf-path" d="M100 100 L148 62" stroke-linecap="round" />
        <circle class="nf-dot" cx="148" cy="62" r="6" />
      </svg>
    </div>
    <div class="wrap">
      <div class="nf-rail">
        <p class="eyebrow anim">Error 404</p>
        <h1 class="nf-title anim d1">This page wandered off.</h1>
        <p class="nf-sub anim d2">
          The link may be old, or the page may have moved. Nothing you did wrong &mdash;
          let&rsquo;s get you somewhere useful.
        </p>
        <div class="nf-actions anim d3">
          <a href="/" class="btn btn-primary">Back to home <span class="arrow" aria-hidden="true">&rarr;</span></a>
          <a href="#map" class="btn btn-ghost">Browse pages</a>
        </div>
      </div>
    </div>
  </section>

  <section class="nf-map" id="map">
    <div class="wrap">
      <div class="nf-rail">
        <span class="eyebrow anim">Find your way</span>
        <h2 class="title anim d1">Or try one of these.</h2>
        <ul class="nf-grid">
          {DESTINATIONS.map((d, i) => (
            <li class={`anim d${Math.min((i % 3) + 1, 3)}`}>
              <a href={d.href}>
                <span class="nf-card-label">{d.label}</span>
                <span class="nf-card-blurb">{d.blurb}</span>
                <span class="nf-card-arrow" aria-hidden="true">&rarr;</span>
              </a>
            </li>
          ))}
        </ul>
        <p class="nf-help anim">
          Still stuck? Email us at
          <a href="mailto:hello@contentment.org">hello@contentment.org</a>
          and we&rsquo;ll point you the right way.
        </p>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .nf-rail { max-width: 1080px; width: 100%; }

  .nf-hero {
    position: relative;
    display: flex;
    align-items: center;
    min-height: clamp(380px, 48vh, 480px);
    padding: clamp(112px, 14vh, 148px) 0 clamp(48px, 6vh, 64px);
    color: #fff;
    overflow: hidden;
    background:
      radial-gradient(1200px 620px at 18% 8%, rgba(31, 175, 192, .34) 0%, rgba(31, 175, 192, 0) 62%),
      linear-gradient(140deg, var(--deep) 0%, var(--deep2, #023a54) 46%, #01374f 100%);
  }
  .nf-hero .wrap { width: 100%; position: relative; z-index: 2; }
  .nf-hero .eyebrow { color: #9fe9f2; }
  .nf-title {
    font-family: var(--display);
    font-weight: 500;
    font-size: clamp(2.3rem, 5.2vw, 3.6rem);
    line-height: 1.04;
    letter-spacing: -.005em;
    margin-top: 14px;
    text-wrap: balance;
  }
  .nf-sub {
    margin-top: 18px;
    font-size: clamp(1.04rem, 1.35vw, 1.18rem);
    line-height: 1.55;
    color: rgba(255, 255, 255, .9);
    max-width: 48ch;
  }
  .nf-actions { margin-top: 28px; display: flex; gap: 14px; flex-wrap: wrap; }

  .nf-motif {
    position: absolute;
    right: clamp(-20px, 3vw, 6%);
    top: 54%;
    translate: 0 -50%;
    width: clamp(140px, 20vw, 260px);
    opacity: .22;
    pointer-events: none;
    z-index: 1;
    animation: nfPulse 8s ease-in-out infinite;
  }
  .nf-motif svg { width: 100%; height: auto; display: block; }
  .nf-ring {
    fill: none;
    stroke: rgba(191, 238, 245, .4);
    stroke-width: 2.5;
  }
  .nf-ring--mid { stroke: rgba(31, 175, 192, .35); }
  .nf-ring--in { stroke: rgba(159, 233, 242, .5); }
  .nf-path { stroke: rgba(191, 238, 245, .7); stroke-width: 3; }
  .nf-dot { fill: rgba(85, 220, 230, .85); }
  @keyframes nfPulse {
    0%, 100% { transform: translateY(0) scale(1); opacity: .22; }
    50% { transform: translateY(-8px) scale(1.04); opacity: .32; }
  }

  .nf-map {
    padding: clamp(40px, 5vw, 72px) 0 clamp(56px, 7vw, 88px);
    background: var(--paper);
  }
  .nf-map .eyebrow { color: var(--ocean); }
  .nf-map .title { margin-top: 10px; color: var(--deep); margin-bottom: 28px; }

  .nf-grid {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 14px;
    padding: 0;
    margin: 0;
  }
  .nf-grid a {
    display: flex;
    flex-direction: column;
    gap: 5px;
    height: 100%;
    padding: 20px 18px;
    border: 1px solid var(--line);
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 10px 34px -26px rgba(2, 55, 79, .45);
    transition: transform .28s cubic-bezier(.2, .8, .2, 1), box-shadow .28s, border-color .28s;
  }
  .nf-grid a:hover,
  .nf-grid a:focus-visible {
    transform: translateY(-4px);
    border-color: var(--teal);
    box-shadow: 0 20px 44px -26px rgba(2, 55, 79, .55);
  }
  .nf-card-label {
    font-family: var(--display);
    font-weight: 600;
    font-size: 1.1rem;
    color: var(--deep);
    line-height: 1.2;
  }
  .nf-card-blurb { font-size: .92rem; color: var(--slate); line-height: 1.45; }
  .nf-card-arrow {
    margin-top: auto;
    padding-top: 10px;
    color: var(--teal);
    font-size: 1.05rem;
    transition: transform .25s;
  }
  .nf-grid a:hover .nf-card-arrow { transform: translateX(4px); }

  .nf-help { margin-top: 28px; font-size: 1rem; color: var(--slate); }
  .nf-help a {
    color: var(--ocean);
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 3px;
    transition: color .2s;
  }
  .nf-help a:hover { color: var(--deep); }

  @media (max-width: 1100px) {
    .nf-grid { grid-template-columns: repeat(3, 1fr); }
  }
  @media (max-width: 900px) {
    .nf-grid { grid-template-columns: 1fr 1fr; }
    .nf-motif {
      opacity: .3;
      right: 10px;
      top: 78px;
      translate: none;
      width: clamp(100px, 30vw, 140px);
      animation: nfPulse 8s ease-in-out infinite;
    }
  }
  @media (max-width: 560px) {
    .nf-grid { grid-template-columns: 1fr; }
    .nf-actions .btn { width: 100%; justify-content: center; }
    .nf-motif { width: 100px; opacity: .34; right: 8px; top: 72px; }
  }

  @media (prefers-reduced-motion: reduce) {
    .nf-motif { animation: none; opacity: .28; }
    .nf-grid a,
    .nf-card-arrow { transition: none; }
    .nf-hero .anim,
    .nf-map .anim { opacity: 1; transform: none; }
  }
</style>

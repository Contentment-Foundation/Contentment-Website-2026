<style>
  /* Page-specific CSS only — reset/wrap/eyebrow/buttons/nav/footer/.anim/section-typography
     system, and the base .hero rules, are already in src/styles/global.css (verified, see
     TECHNICAL-ARCHITECTURE §3). This page's own hero variant (.hero-map) fully replaces the
     base .hero::after background via a same-specificity, later-in-cascade selector, so the
     base .hero rules don't need to be repeated here.
     Kit boilerplate this page doesn't use (.impact/.stats, .split, .how/.how-orbit,
     .alone/.circles, .pillars, .doors, .tiers/.homeroom, .voice, .news) is omitted — dead
     CSS, no matching markup on this page. Also dropped as genuinely dead within the
     "Stories page addendum" itself (no matching markup anywhere in this page's HTML):
     .gstat, the alternate SVG-worldmap `.regcards`/`.rc-grid`/`.rc` region-card grid,
     `.devflag`, `.vquote`/`.vq-portrait`, the bare `.rhl` wrapper (superseded by the
     `.mag-stats .rhl-i` version below), and the `.region.flip` combinator (this page uses
     the single `.region-flip-mag` class instead). */

  /* ---------- HERO (single full-screen composition, map as faint wallpaper) ---------- */
  .hero-map{background:url('/assets/oi-img-01.jpg') center/cover no-repeat, #6cbfa0;
     position:relative;overflow:hidden;
     height:100svh;min-height:680px;display:flex;align-items:stretch}
  .hero-map::after{content:"";position:absolute;inset:0;z-index:1;
     background:linear-gradient(160deg,rgba(255,255,255,.28) 0%,rgba(108,191,160,.05) 45%,rgba(46,120,100,.18) 100%)}
  .hero-map .hero-worldmap{position:absolute;inset:0;z-index:0;pointer-events:none;
     display:flex;align-items:center;justify-content:center}
  .hero-map .hero-worldmap img{width:100%;height:auto;max-width:1600px;
     mix-blend-mode:overlay;opacity:.10;object-fit:contain}
  .hero-map .hero-inner{position:relative;z-index:2;width:100%;
     display:flex;flex-direction:column;justify-content:space-between;
     padding-top:150px;padding-bottom:48px}
  .hero-map .hero-top{max-width:960px}
  .hero-map .hero-q{margin-top:14px;color:var(--deep)}
  .hero-map .hero-q .cursive{font-family:var(--script);font-weight:400;
     font-style:normal;color:var(--deep);padding-right:.12em}
  .hero-map .hero-mid .lead{margin:0 0 22px}
  .hero-map .lead-accent{font-family:var(--display);font-style:italic;font-weight:400;
     font-size:clamp(1.3rem,1.9vw,1.72rem);line-height:1.34;letter-spacing:.002em}
  .hero-map .hero-regions{margin:0 auto}
  .hero-map .hero-stats{margin-top:0}

  /* region cards: the centered focal band */
  .hero-regions{display:flex;flex-wrap:wrap;justify-content:center;gap:20px;
     max-width:1120px}
  .hrc{position:relative;text-decoration:none;min-width:0;
     flex:0 1 calc((100% - 80px) / 5);max-width:calc((100% - 80px) / 5);
     transition:transform .3s ease}
  .hrc:hover{transform:translateY(-6px)}
  .hrc .ph{position:relative;display:block;aspect-ratio:1/1;
     border-radius:16px;overflow:hidden;
     box-shadow:0 20px 48px -22px rgba(0,20,35,.75);
     transition:box-shadow .3s ease}
  .hrc:hover .ph{box-shadow:0 30px 64px -24px rgba(0,20,35,.85)}
  .hrc .ph img{width:100%;height:100%;object-fit:cover;display:block}
  .hrc-name{display:block;margin-top:12px;color:#fff;text-align:center;
     font:600 1.02rem/1.15 var(--display);text-transform:uppercase;
     letter-spacing:.03em}
  .hrc.soon .hrc-badge{position:absolute;top:12px;left:12px;z-index:4;
     font:700 .58rem/1.15 var(--body);letter-spacing:.08em;text-transform:uppercase;
     text-align:left;
     background:rgba(2,55,79,.72);color:#fff;border:1px solid rgba(255,255,255,.45);
     padding:8px 10px;border-radius:12px;backdrop-filter:blur(5px)}

  /* stats: bottom anchor of the hero composition */
  .hero-stats{display:flex;flex-wrap:wrap;gap:8px 30px;align-items:baseline;
     justify-content:flex-start;padding-top:26px;border-top:1px solid rgba(255,255,255,.16)}
  .hero-stats b{font:600 1.04rem/1.3 var(--display);color:#27664f}
  .hero-stats span{font:600 1.04rem/1.3 var(--display);color:#27664f;opacity:1}
  .hero-stats .sep{opacity:.34;padding:0 2px}

  /* Locked breakpoints: ≤940 / ≤760 / ≤560 (match homepage audit) */
  @media(max-width:940px){
    .hero-map{height:auto;min-height:0}
    .hero-map .hero-inner{padding-top:110px;padding-bottom:36px;gap:28px}
    .hero-regions{gap:16px;max-width:640px}
    .hrc{flex-basis:calc((100% - 32px) / 3);max-width:calc((100% - 32px) / 3)}
    .hrc-name{font-size:clamp(.88rem,2.2vw,1.02rem)}
    .hrc.soon .hrc-badge{top:8px;left:8px;padding:6px 8px;font-size:.52rem}
    .hero-stats{gap:6px 20px;padding-top:20px}
    .hero-stats b,.hero-stats span{font-size:.98rem}
  }
  @media(max-width:560px){
    .hero-map{padding-bottom:10px}
    .hero-map .hero-inner{padding-top:96px;padding-bottom:28px;gap:28px}
    .hero-map .lead-accent{font-size:clamp(1.15rem,5.2vw,1.4rem)}
    .hero-regions{gap:12px;max-width:none}
    .hrc{flex-basis:calc((100% - 12px) / 2);max-width:calc((100% - 12px) / 2)}
    .hrc .ph{border-radius:14px}
    .hrc-name{font-size:.9rem;margin-top:10px}
    .hero-stats{gap:4px 12px}
    .hero-stats b,.hero-stats span{font-size:.86rem}
    .hero-stats .sep{display:none}
  }

  /* duotone placeholder tile — sits behind the real photo in .hrc .ph; harmless, fully
     covered by the real <img>, kept for source fidelity */
  .ph{position:relative;display:flex;align-items:flex-end;overflow:hidden;background:
     linear-gradient(135deg,var(--deep) 0%,var(--ocean) 55%,var(--teal) 130%);
     color:#EAF7F1}
  .ph::before{content:"";position:absolute;inset:0;
     background:radial-gradient(120% 120% at 80% -10%,rgba(255,255,255,.10),transparent 60%);
     mix-blend-mode:screen}

  /* --- region section --- */
  .region{padding:88px 0 8px}
  .region .wrap{max-width:1180px}
  .region-photo{position:relative;border-radius:20px;overflow:hidden;
     aspect-ratio:21/9;box-shadow:var(--shadow);margin-bottom:8px}
  .region-photo img{position:absolute;inset:0;width:100%;height:100%;
     object-fit:cover;object-position:center 42%;display:block}
  .region-eyebrow{color:var(--ocean)}
  /* big, unmistakable region section headers */
  .region-header{font:600 clamp(2.4rem,5vw,3.6rem)/1.02 var(--display);
     color:var(--deep);text-transform:uppercase;letter-spacing:.01em;
     margin:0 0 22px}
  .region-header em{display:inline-block;font:500 .9rem/1 var(--body);
     letter-spacing:.16em;text-transform:uppercase;color:var(--ocean);
     vertical-align:middle;margin-left:14px;font-style:normal;
     background:var(--mist);padding:7px 12px;border-radius:999px}
  .region-body{display:grid;grid-template-columns:1.05fr 1fr;gap:52px;
     align-items:start;margin-top:40px}
  .region-story .title{margin:12px 0 18px}
  .region-story p{font:400 1.06rem/1.72 var(--body);color:var(--slate);
     max-width:52ch}
  .region-story p + p{margin-top:1.1em}
  .region-story .lede{color:var(--ink)}
  .region-story .lede-open{font-weight:600;color:var(--deep)}

  /* --- video feature + thumbnail row (captions below the image) --- */
  .region-vid{position:relative}
  .vfeat{position:relative;display:block;width:100%;
     cursor:pointer;background:none;border:0;padding:0;box-shadow:none;text-align:left;
     -webkit-appearance:none;appearance:none;font:inherit;color:inherit}
  .vfeat .vposter{position:relative;display:block;width:100%;aspect-ratio:16/9;
     border-radius:16px;overflow:hidden;background-size:cover;
     background-position:center;box-shadow:var(--shadow);transition:transform .5s ease}
  .vfeat:hover .vposter{transform:translateY(-2px)}
  .vfeat .vscrim{position:absolute;inset:0;border-radius:16px;
     background:linear-gradient(to top,rgba(2,45,66,.28),transparent 45%)}
  .vplay{position:absolute;top:calc(50% - 20px);left:50%;transform:translate(-50%,-50%);
     width:66px;height:66px;border-radius:50%;background:rgba(255,255,255,.94);
     display:grid;place-items:center;z-index:3;transition:transform .3s ease}
  .vfeat:hover .vplay{transform:translate(-50%,-50%) scale(1.08)}
  .vplay::after{content:"";width:0;height:0;margin-left:4px;
     border-left:19px solid var(--deep);border-top:12px solid transparent;
     border-bottom:12px solid transparent}
  .vlabel{display:block;margin-top:13px;color:var(--ink);
     font:600 1.06rem/1.28 var(--display)}
  .vlabel i{display:block;font:500 .82rem/1.3 var(--body);letter-spacing:.01em;
     color:var(--slate);margin-top:5px;font-style:normal}

  /* framed feature video (magazine lead): colored card + indented caption */
  .mag-lead-vid{background:var(--deep);border-radius:20px;overflow:hidden;
     box-shadow:0 24px 60px -28px rgba(2,40,58,.7)}
  .mag-lead-vid .vfeat{padding:14px 14px 0}
  .mag-lead-vid .vposter{border-radius:12px;box-shadow:none}
  .mag-lead-vid .vscrim{border-radius:12px}
  .mag-lead-vid .vlabel{color:#fff;padding:16px 20px 20px;margin-top:0}
  .mag-lead-vid .vlabel i{color:#CFE8EE}

  .vrow{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:14px;margin-top:16px}
  .vthumb{position:relative;display:block;cursor:pointer;background:none;
     border:0;padding:0;box-shadow:none;text-align:left;min-width:0;
     -webkit-appearance:none;appearance:none;font:inherit;color:inherit}
  .vthumb .vposter{position:relative;display:block;width:100%;aspect-ratio:16/9;
     border-radius:11px;overflow:hidden;background-size:cover;background-position:center;
     box-shadow:0 10px 26px -14px rgba(2,55,79,.4)}
  .vthumb .vscrim{display:none}
  .vthumb .vplay{width:38px;height:38px;top:50%}
  .vthumb:hover .vplay{transform:translate(-50%,-50%) scale(1.08)}
  .vthumb .vplay::after{border-left:12px solid var(--deep);border-top:7px solid transparent;border-bottom:7px solid transparent;margin-left:3px}
  .vthumb .vt-cap{display:block;margin-top:9px;color:var(--slate);
     font:500 .8rem/1.32 var(--body)}

  /* --- educator voices (interactive: face -> expanding quote) --- */
  .voices{margin:46px 0 4px}
  .voices-lab{font:600 .74rem/1 var(--body);letter-spacing:.14em;
     text-transform:uppercase;color:var(--ocean);margin-bottom:20px}

  /* Hawaiian / non-english term styling */
  .term{font-style:italic}
  .gloss{font-style:normal;color:var(--slate)}

  /* ===== per-region accent color system ===== */
  #bhutan{--accent:#54bf98;--accent-box:#54bf98;--accent-quotebox:#c6e4dc}
  #kenya{--accent:#32c0cf;--accent-box:#32c0cf;--accent-quotebox:#c7ecef;background:#f2f2f1}
  #hawaii{--accent:#0090be;--accent-box:#0090be;--accent-quotebox:#caeff4}
  #mainland{--accent:#0090be;--accent-box:#0090be;--accent-quotebox:#d6f4f8;background:#f2f2f1}
  /* apply accent to region elements */
  .region-mag .region-header{color:var(--accent,var(--deep))}
  .region-mag .mag-lead-text .lede-open{color:var(--accent,var(--deep))}
  .region-mag .voices-lab{color:var(--accent,var(--ocean))}
  .region-mag .mag-stats .rnum{color:var(--accent,var(--deep))}
  .region-mag .vp-name{color:var(--accent,var(--deep))}
  .region-mag .vpanel cite b{color:var(--accent,var(--deep))}
  .region-mag .mag-lead-vid{background:var(--accent-box,var(--deep))}
  .region-mag .vpanel{background:var(--accent-quotebox,var(--mist))}
  .region-mag .vpanel::before{background:var(--accent-quotebox,var(--mist))}
  .region-mag .vperson[aria-selected="true"] .vp-portrait{box-shadow:0 0 0 4px var(--accent,var(--teal)),0 16px 38px -14px rgba(2,55,79,.6)}

  /* ===== region separation: alternating tint + line ornament divider ===== */
  .region-mag{position:relative;padding:70px 0 84px}
  .region-mag::after{content:"";position:absolute;left:50%;bottom:0;
     transform:translate(-50%,50%);width:280px;height:1px;z-index:2;
     background:linear-gradient(to right,transparent,var(--slate) 30%,var(--slate) 70%,transparent);
     opacity:.45}
  .region-mag::before{content:"";position:absolute;left:50%;bottom:0;
     transform:translate(-50%,50%) rotate(45deg);width:7px;height:7px;z-index:3;
     background:var(--slate);opacity:.55}

  /* ===== MAGAZINE region layout ===== */
  .region-mag .region-photo{margin-bottom:38px}
  .mag-intro{max-width:none;margin:0 0 30px}
  .mag-intro .region-header{margin-bottom:0;font-size:clamp(3rem,5vw,4.4rem);
     line-height:1.0;white-space:nowrap}
  /* North America: two long words in a flipped column -> smaller so it fits */
  #mainland .region-header{font-size:clamp(2.4rem,3.6vw,3.2rem)}
  /* non-flip: text is left column (1fr of 1fr+1.15fr) -> header sits over it */
  .region-mag:not(.region-flip-mag) .mag-intro{width:calc(46.5% - 22px)}
  /* flip: text is right column -> header right-aligned over it */
  .region-flip-mag .mag-intro{width:calc(46.5% - 22px);margin-left:auto}

  /* lead: feature video + story text side by side */
  .mag-lead{display:grid;grid-template-columns:1fr 1.15fr;gap:44px;align-items:start;
     margin-bottom:16px}
  .mag-lead-text{order:1}
  .mag-lead-vid{order:2}
  /* flipped magazine region: video left, text right, title over the text */
  .region-flip-mag .mag-lead{grid-template-columns:1.15fr 1fr}
  .region-flip-mag .mag-lead-vid{order:1}
  .region-flip-mag .mag-lead-text{order:2}
  .mag-lead-text p{font:400 1.04rem/1.72 var(--body);color:var(--slate);margin:0}
  .mag-lead-text p + p{margin-top:1.1em}
  .mag-lead-text .lede-open{font-weight:600;color:var(--deep)}

  /* stats: contained color block, tidy aligned columns */
  .mag-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:22px 44px;
     margin:44px 0 8px;padding:38px 44px;background:#fff;border-radius:20px;
     box-shadow:0 18px 44px -26px rgba(2,55,79,.4)}
  .mag-stats .rhl-i{display:grid;grid-template-columns:4.6em 1fr;gap:16px;align-items:baseline}
  .mag-stats .rnum{font:600 1.6rem/1 var(--display);color:var(--deep);white-space:nowrap;text-align:right}
  .mag-stats .lab{font:400 .9rem/1.42 var(--body);color:var(--slate)}

  /* more-to-watch video row: deep navy block, matches feature frame */
  .mag-more{margin-top:60px;background:var(--deep);border-radius:22px;
     padding:44px 44px 48px}
  .mag-more .voices-lab{color:#fff;margin-bottom:20px;opacity:.92}
  .mag-vrow{margin-top:0}
  .mag-more .vt-cap{color:#EAF7F1}
  .mag-more .vthumb .vposter{box-shadow:0 14px 30px -14px rgba(0,20,35,.6)}

  /* ===== interactive educator voices (faces -> expanding quote) ===== */
  .voices-interactive{margin-top:52px}
  .voices-people{display:grid;grid-template-columns:repeat(3,1fr);gap:18px}
  .voices-people.vp-2{grid-template-columns:repeat(2,minmax(0,260px));justify-content:center;gap:60px}
  .vperson{display:flex;flex-direction:column;align-items:center;text-align:center;
     gap:12px;cursor:pointer;background:none;border:0;padding:14px 12px;
     border-radius:16px;-webkit-appearance:none;appearance:none;font:inherit;color:inherit;
     transition:background .25s ease,transform .25s ease,box-shadow .25s ease}
  .vperson:hover{background:var(--paper2);transform:translateY(-3px)}
  .vperson[aria-selected="true"]{background:var(--accent-quotebox,var(--mist))}
  .vp-portrait{width:100%;max-width:220px;aspect-ratio:1/1;height:auto;
     border-radius:24px;overflow:hidden;flex:none;
     box-shadow:0 16px 38px -16px rgba(2,55,79,.55);position:relative;
     transition:box-shadow .25s ease,transform .25s ease}
  .vperson[aria-selected="true"] .vp-portrait{box-shadow:0 0 0 4px var(--teal),0 16px 38px -14px rgba(2,55,79,.6)}
  .vp-portrait img{width:100%;height:100%;object-fit:cover;display:block}
  .vp-name{font:600 1.24rem/1.2 var(--display);color:var(--deep)}

  .voices-panels{margin-top:8px}
  .vpanel{display:none;position:relative;margin:22px auto 0;max-width:none;
     background:var(--mist);border-radius:18px;padding:30px 34px 26px;
     font:400 1.16rem/1.56 var(--display);font-style:italic;color:var(--ink)}
  .vpanel.open{display:block;animation:vfade .3s ease}
  .vpanel::before{content:"";position:absolute;top:-9px;left:var(--arrow,16%);
     width:18px;height:18px;background:var(--mist);transform:rotate(45deg)}
  .vpanel cite{display:block;margin-top:18px;font-style:normal}
  .vpanel cite b{display:block;font:600 .98rem/1.3 var(--body);color:var(--deep)}
  .vpanel cite span{display:block;margin-top:3px;font:400 .88rem/1.4 var(--body);color:var(--slate)}
  @keyframes vfade{from{opacity:0;transform:translateY(-6px)}to{opacity:1;transform:none}}

  @media(max-width:940px){
    .mag-lead,.region-flip-mag .mag-lead{grid-template-columns:1fr;gap:18px}

  .schoolsvid .videoframe{margin-top:38px;position:relative;aspect-ratio:16/9;border-radius:18px;overflow:hidden;box-shadow:var(--shadow);background:#02374f;cursor:pointer;border:1px solid rgba(255,255,255,.16)}

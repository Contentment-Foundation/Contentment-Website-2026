  .schoolsvid .btn-playlist:hover{background:#e6f7fb;color:var(--deep);transform:translateY(-2px);box-shadow:0 0 34px 4px rgba(214,241,246,.55),0 14px 30px -16px rgba(2,55,79,.5)}
  .schoolsvid .btn-playlist:focus{outline:none}
  .schoolsvid .btn-playlist:focus-visible{outline:none;box-shadow:0 0 0 3px rgba(214,241,246,.6),0 14px 30px -16px rgba(2,55,79,.5)}
  .schoolsvid .btn-playlist .arrow{transition:transform .25s;display:inline-block}
  .schoolsvid .btn-playlist:hover .arrow{transform:translateX(4px)}
</style>

<script>
  // Page-specific behaviour not covered by src/scripts/*: video lightbox / inline data-yt
  // play, and the interactive "educator voices" face -> quote panels. Ported verbatim from
  // this page's own inline <script> in the source handoff (nav scroll, hero entrance,
  // reveal-on-scroll, count-up are already handled globally by BaseLayout's
  // animations.js/nav.js).
  import { youtubeIframeHtml } from '../../scripts/youtube-embed.js';
  import { attachLightboxA11y } from '../../scripts/lightbox-a11y.js';

  // Our Impact: nav pinned white — the hero ground here is light green/white, not dark,
  // so the header must render in its scrolled (white-bar) state even at the very top of
  // the page. Ported from the source's own `hdr.classList.add('scrolled')` call.
  const hdr = document.getElementById('hdr');
  hdr?.classList.add('scrolled');

  // video lightbox for any element with data-yt
  const lb = document.getElementById('lb');
  const lbSlot = document.getElementById('lbSlot');
  const lbClose = document.getElementById('lbClose');

  // Focus management for the cross-origin YouTube frame — see lightbox-a11y.js.
  // The old `window`-scoped Escape handler could never fire once focus was inside
  // the player, which made this a real keyboard trap (WCAG 2.1.2 A).
  const lbA11y = attachLightboxA11y(lb!, lbClose!, () => closeLb());

  function openLb(id?: string, list?: string, trigger?: HTMLElement) {
    if (!lbSlot || !lb) return;
    if (!id || id === 'PENDING_YT_ID') {
      lbSlot.innerHTML = '<div style="color:#fff;padding:60px 30px;text-align:center;font-family:Inter,sans-serif">Video coming soon.</div>';
      lb.classList.add('open');
      lbA11y.opened(trigger);
      return;
    }
    lbSlot.innerHTML = youtubeIframeHtml(id, { list });
    lb.classList.add('open');
    lbA11y.opened(trigger);
  }
  function closeLb() {
    if (!lbSlot || !lb) return;
    lb.classList.remove('open');
    lbSlot.innerHTML = '';
    lbA11y.closed();
  }
  document.querySelectorAll<HTMLElement>('[data-yt]').forEach((el) => {
    el.addEventListener('click', () => openLb(el.dataset.yt, el.dataset.list, el));
    el.addEventListener('keydown', (e) => {
      if (e.key === 'Enter' || e.key === ' ') { e.preventDefault(); openLb(el.dataset.yt, el.dataset.list, el); }
    });
  });
  lbClose?.addEventListener('click', closeLb);
  lb?.addEventListener('click', (e) => { if (e.target === lb) closeLb(); });

  // interactive educator voices: click a face -> reveal its quote panel. Native <button
  // role="tab"> elements, so Enter/Space activation is free via the native click event —
  // no extra keydown handler needed (unlike the div-based [data-yt] triggers above).
  document.querySelectorAll<HTMLElement>('[data-voices]').forEach((group) => {
    const people = [...group.querySelectorAll<HTMLElement>('.vperson')];
    const panels = group.querySelector('.voices-panels');
    function show(btn: HTMLElement) {
      const id = btn.dataset.vq;
      people.forEach((p) => p.setAttribute('aria-selected', p === btn ? 'true' : 'false'));
      group.querySelectorAll('.vpanel').forEach((pl) => pl.classList.toggle('open', pl.id === id));
      // point the arrow at the active face
      if (!panels) return;
      const gr = panels.getBoundingClientRect(), br = btn.getBoundingClientRect();
      const cx = br.left + br.width / 2 - gr.left;
      const panel = group.querySelector('#' + CSS.escape(id ?? ''));
      if (panel instanceof HTMLElement) panel.style.setProperty('--arrow', (cx - 9) + 'px');
    }
    people.forEach((btn) => {
      btn.addEventListener('click', () => {
        if (btn.getAttribute('aria-selected') === 'true') {
          // clicking the open one closes it
          btn.setAttribute('aria-selected', 'false');
          group.querySelectorAll('.vpanel').forEach((pl) => pl.classList.remove('open'));
        } else {
          show(btn);
        }
      });
    });
    // open the first by default
    if (people[0]) show(people[0]);
    // reposition arrow on resize
    addEventListener('resize', () => {
      const sel = group.querySelector<HTMLElement>('.vperson[aria-selected="true"]');
      if (sel) show(sel);
    }, { passive: true });
  });
</script>

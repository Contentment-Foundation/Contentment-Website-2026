<!-- ============ SCHOOLS OF WELLBEING VIDEO (shared with For Schools) ============ -->
<section class="schoolsvid">
  <div class="wrap">
    <span class="eyebrow anim">In their own words</span>
    <h2 class="anim d1">See the work in real schools</h2>
    <p class="vsub anim d1">Our Schools of Wellbeing series: educators and leaders sharing what changed.</p>
    <div class="videoframe anim d2" role="button" tabindex="0" data-yt="Ot_ZecrcNs0" data-list="PL6grto2rTA0-W5HRhrk6i7S0UqJ2030Q3" aria-label="Play video: The Country School">
      <div class="vposter" style="background-image:url('/assets/oi-img-32.jpg')"></div>
      <div class="vplay"></div>
      <div class="vlabel">The Country School</div>

  /* ===== "See the work in real schools" video fold (shared with For Schools) ===== */
  .schoolsvid{background:url('/assets/oi-img-02.jpg') center/cover no-repeat, var(--deep);color:#fff;position:relative;overflow:hidden;padding:82px 0 90px}

---
// Our Impact — migrated verbatim from Dave's Jul 29 2026 handoff:
// handoff/2026-07-29-dave-pages/3_OUR IMPACT/our-impact-github-build_1/index.html
// (the de-inlined form, per HANDOFF.md §5 — canonical repo copy).
// See docs/planning/TECHNICAL-ARCHITECTURE.md §3 — no redesign, structure/CSS copied as-is.
// Shared <Nav />/<Footer /> replace this page's own header/footer markup (deleted per
// migration hard rules); nav/footer seams are wired centrally in src/config/seams.ts.
//
// Note on the two-triangle play-button bug (HANDOFF.md §2): already fixed upstream in
// this source file via `.schoolsvid .videoframe .vplay::before{content:none}` — ported
// verbatim below, do not remove.
//
// Deliberate deviation from source (flagged, not a visual change): the per-region
// highlight numbers (source class `.mag-stats .num`, e.g. "210", "90.9%", "9 in 10")
// were renamed to `.rnum` in this file only. BaseLayout's shared initCountUp()
// (src/scripts/animations.js) calls `document.querySelectorAll('.num')` on every page
// and rewrites an element's textContent from `+el.dataset.count`; these labels have no
// `data-count` (they're static, and several carry a "%"/"+"/text suffix count-up can't
// reproduce), so under the literal `.num` class the shared script would overwrite each
// one with the string "NaN" once scrolled into view. Renaming sidesteps the collision
// without touching animations.js (out of scope here). Same underlying class-name
// collision appears to exist on why.astro's `.stat .num` block too — flagged in the
// handoff report for whoever owns that page, not fixed here.
import BaseLayout from '../../layouts/BaseLayout.astro';
import { seams } from '../../config/seams';
---
<BaseLayout
  title="Our Impact — The Contentment Foundation"
  description="We equip teachers with evidenced wellbeing practices. See the impact in 12 countries, from Bhutan to Hawaiʻi, where 325 schools are flourishing."
>

<!-- ============ HERO (single full-screen composition, map as faint wallpaper) ============ -->
<section class="hero hero-map" id="top">
  <div class="hero-worldmap"><img src="/assets/oi-worldmap.png" alt="" width="1600" height="973"></div>
  <div class="hero-inner wrap">
    <div class="hero-top">
      <span class="eyebrow anim" style="color:#2E7864">Stories from the field</span>
      <h1 class="hero-q">
        <span class="l1 anim"><span class="cursive">Wellbeing</span> is taking</span>
        <span class="l2 anim d1">root in classrooms</span>
        <span class="l3 anim d2">around the world.</span>
      </h1>
    </div>
    <div class="hero-mid">
      <p class="lead lead-accent anim d2" style="color:#c2ebe1;font-weight:600;max-width:52ch">Meet the teachers living this work, region by region.</p>
      <div class="hero-regions anim d3" id="regions">
        <a class="hrc" href="#bhutan"><span class="ph"><img src="/assets/oi-img-04.jpg" alt="Bhutan" width="760" height="760"></span><span class="hrc-name">Bhutan</span></a>
        <a class="hrc" href="#kenya"><span class="ph"><img src="/assets/oi-img-05.jpg" alt="East Africa" width="760" height="760"></span><span class="hrc-name">East Africa</span></a>
        <a class="hrc" href="#hawaii"><span class="ph"><img src="/assets/oi-img-06.jpg" alt="Hawai&#699;i" width="760" height="760"></span><span class="hrc-name">Hawai&#699;i</span></a>
        <a class="hrc" href="#mainland"><span class="ph"><img src="/assets/oi-img-07.jpg" alt="North America" width="760" height="760"></span><span class="hrc-name">North America</span></a>
        <a class="hrc soon" href="#singapore"><span class="hrc-badge">Coming<br>2027</span><span class="ph"><img src="/assets/oi-img-08.jpg" alt="Singapore" width="760" height="760"></span><span class="hrc-name">Singapore</span></a>
      </div>
    </div>
    <div class="hero-stats anim d3">
      <b>12 countries</b><span class="sep">&middot;</span><b>4 continents</b><span class="sep">&middot;</span>
      <b>325</b><span>partner schools</span><span class="sep">&middot;</span>
      <b>11,925</b><span>educators reached</span><span class="sep">&middot;</span>
      <b>409,625+</b><span>students reached</span>
    </div>
  </div>
</section>

<!-- ============ REGION: BHUTAN ============ -->
<section class="region region-mag" id="bhutan">
  <div class="wrap">
    <div class="region-photo anim"><img src="/assets/oi-img-09.jpg" alt="Educators in Bhutan" width="1236" height="529"></div>

    <div class="mag-intro anim">
      <h2 class="region-header">Bhutan</h2>
    </div>

    <div class="mag-lead anim">
      <div class="mag-lead-vid">
        <button class="vfeat" data-yt="18gc2s-JSjY" aria-label="Play video: ELC High School, Thimphu">
          <span class="vposter" style="background-image:url('/assets/oi-img-10.jpg')"></span>
          <span class="vscrim"></span><span class="vplay"></span>
        </button>
        <span class="vlabel">ELC High School<i>Thimphu, Bhutan &middot; video story</i></span>
      </div>
      <div class="mag-lead-text">
        <p class="lede"><strong class="lede-open">It started with a single school in Thimphu in 2019.</strong> Not a government mandate, not a national rollout, just one circle of educators willing to sit together and ask: what does it feel like to be well?</p>
        <p>That question changed everything. ELC (Educating for Lifelong Citizenship) High School became a lighthouse school, a place where wellbeing isn&#8217;t delivered at certain hours but lived throughout the culture. From there the work grew, from one school to 50 across a valley, to annual retreats with school counselors nationwide.</p>
      </div>
    </div>

    <div class="mag-stats anim">
      <div class="rhl-i"><div class="rnum">210</div><div class="lab">schools with a trained educator</div></div>
      <div class="rhl-i"><div class="rnum">500</div><div class="lab">educators in the national community</div></div>
      <div class="rhl-i"><div class="rnum">200</div><div class="lab">counselors trained</div></div>
      <div class="rhl-i"><div class="rnum">90.9%</div><div class="lab">called the wellbeing retreats deeply effective (2025)</div></div>
      <div class="rhl-i"><div class="rnum">94.4%</div><div class="lab">came away deeply restored</div></div>
      <div class="rhl-i"><div class="rnum">88.8%</div><div class="lab">would recommend it to a colleague facing burnout</div></div>
    </div>

    <div class="voices voices-interactive anim" data-voices>
      <div class="voices-lab">What educators told us</div>
      <div class="voices-people vp-2" role="tablist">
        <button class="vperson" role="tab" aria-selected="false" data-vq="bhu-1">
          <span class="vp-portrait"><img src="/assets/oi-img-11.jpg" alt="Deki Choden" width="360" height="360"></span>
          <span class="vp-name">Deki Choden</span>
        </button>
        <button class="vperson" role="tab" aria-selected="false" data-vq="bhu-2">
          <span class="vp-portrait"><img src="/assets/oi-img-12.jpg" alt="Yeshi Wangchuk" width="400" height="400"></span>
          <span class="vp-name">Yeshi Wangchuk</span>
        </button>
      </div>
      <div class="voices-panels">
        <blockquote class="vpanel" id="bhu-1">Wellbeing is the non-negotiable subject every school should have. It&#8217;s been a gift that our children have the language to name what they feel. They will be a force of good, not just for themselves, but for the world.<cite><b>Deki Choden</b><span>Head of School, ELC High School, Bhutan</span></cite></blockquote>
        <blockquote class="vpanel" id="bhu-2">As a teacher you feel like you never have enough time. After this training, I&#8217;ve learned that accepting things as they are can be a beautiful thing, and I&#8217;ve started sharing it with everyone. The attitude you bring to your work matters a lot.<cite><b>Yeshi Wangchuk</b><span>Teacher, Changangkha Middle Secondary School, Bhutan</span></cite></blockquote>
      </div>
    </div>

  </div>
</section>

<!-- ============ REGION: KENYA ============ -->
<section class="region region-mag region-flip-mag" id="kenya">
  <div class="wrap">
    <div class="region-photo anim"><img src="/assets/oi-img-13.jpg" alt="Educators in East Africa with the Contentment Foundation flag" width="1500" height="643"></div>

    <div class="mag-intro anim">
      <h2 class="region-header">East Africa</h2>
    </div>

    <div class="mag-lead anim">
      <div class="mag-lead-vid">
        <button class="vfeat" data-yt="vo2VAWoxc34" aria-label="Play video: Nyang'ori Boys High School">
          <span class="vposter" style="background-image:url('/assets/oi-img-14.jpg')"></span>
          <span class="vscrim"></span><span class="vplay"></span>
        </button>
        <span class="vlabel">Nyang&#699;ori Boys High School<i>Vihiga County, Kenya &middot; video story</i></span>
      </div>
      <div class="mag-lead-text">
        <p class="lede"><strong class="lede-open">Many African educators carry extraordinary weight:</strong> overcrowded classrooms, student needs shaped by poverty and broken homes, and constant pressure at the front line of support.</p>
        <p>Many were giving everything and running on empty, some close to leaving the profession. The Four Pillars of Wellbeing offered something different, an invitation to turn inward first and become, as one educator put it, a self-scientist. Across Kenya, Uganda, Tanzania, and the DRC, teachers who found calm in themselves brought that calm to their classrooms. What began in Kenya in 2023 has taken root across the region, not by replication, but through local ownership. It turns out wellbeing is contagious.</p>
      </div>
    </div>

    <div class="mag-stats anim">
      <div class="rhl-i"><div class="rnum">4</div><div class="lab">countries, begun in Kenya</div></div>
      <div class="rhl-i"><div class="rnum">300+</div><div class="lab">teachers in the Africa community</div></div>
      <div class="rhl-i"><div class="rnum">20+</div><div class="lab">youth communities reached across Africa</div></div>
      <div class="rhl-i"><div class="rnum">86%</div><div class="lab">felt their own wellbeing improve (2025)</div></div>
      <div class="rhl-i"><div class="rnum">100%</div><div class="lab">saw their relationships improve</div></div>
      <div class="rhl-i"><div class="rnum">100%</div><div class="lab">felt ready to bring the Four Pillars to their school and community</div></div>
    </div>

    <div class="voices voices-interactive anim" data-voices>
      <div class="voices-lab">What educators told us</div>
      <div class="voices-people" role="tablist">
        <button class="vperson" role="tab" aria-selected="false" data-vq="ea-1">
          <span class="vp-portrait"><img src="/assets/oi-img-15.jpg" alt="Evelyn Bilha Wanjiru" width="400" height="400"></span>
          <span class="vp-name">Evelyn Bilha Wanjiru</span>
        </button>
        <button class="vperson" role="tab" aria-selected="false" data-vq="ea-2">
          <span class="vp-portrait"><img src="/assets/oi-img-16.jpg" alt="Sister Jane Soita" width="360" height="360"></span>
          <span class="vp-name">Sister Jane Soita</span>
        </button>
        <button class="vperson" role="tab" aria-selected="false" data-vq="ea-3">
          <span class="vp-portrait"><img src="/assets/oi-img-17.jpg" alt="Micah Nkalubo" width="360" height="360"></span>
          <span class="vp-name">Micah Nkalubo</span>
        </button>
      </div>
      <div class="voices-panels">
        <blockquote class="vpanel" id="ea-1">Having taught for more than 25 years, I have never felt as fulfilled as I have in the last 3 years of my teaching journey.<cite><b>Evelyn Bilha Wanjiru</b><span>Teacher, Thika Girls Karibaribi, Kenya</span></cite></blockquote>
        <blockquote class="vpanel" id="ea-2">Before the Four Pillars, I was about to resign as Director. I was sliding into mental distress. Mindfulness gave me a new lease on life. I no longer feel stressed and tired, and I can give my students and staff my full attention.<cite><b>Sister Jane Soita</b><span>Director, Starehe Girls Centre and School, Kenya</span></cite></blockquote>
        <blockquote class="vpanel" id="ea-3">We now have 20 communities across Africa supporting young people through self-discovery, many from disadvantaged backgrounds: former child soldiers, refugees, orphans. The Four Pillars gave us a better starting point to address not just mental health, but the whole wellbeing of our scholars and trainers. It&#8217;s a preventative approach to wellness, which is rare on this side of the world.<cite><b>Micah Nkalubo</b><span>Community Building Strategist, SINA Global</span></cite></blockquote>
      </div>
    </div>
  </div>
</section>

<!-- ============ REGION: HAWAII ============ -->
<section class="region region-mag" id="hawaii">
  <div class="wrap">
    <div class="region-photo anim"><img src="/assets/oi-img-18.jpg" alt="Educators at a Hawaii Level 2 wellbeing training" width="1500" height="642"></div>

    <div class="mag-intro anim">
      <h2 class="region-header">Hawai&#699;i</h2>
    </div>

    <div class="mag-lead anim">
      <div class="mag-lead-vid">
        <button class="vfeat" data-yt="grCEinjo3C8" aria-label="Play video: Deepening Educator Wellbeing">
          <span class="vposter" style="background-image:url('/assets/oi-img-19.jpg')"></span>
          <span class="vscrim"></span><span class="vplay"></span>
        </button>
        <span class="vlabel">Deepening Educator Wellbeing<i>Level 2 Educator Training, Hawai&#699;i &middot; video story</i></span>
      </div>
      <div class="mag-lead-text">
        <p class="lede"><strong class="lede-open">Hawai&#699;i doesn&#8217;t need another wellness program.</strong> What educators across 10 schools on O&#699;ahu, Kaua&#699;i, Maui, and Hawai&#699;i Island needed was a partner willing to slow down, listen, and earn the right to be present.</p>
        <p>As Jennifer Gonsalves, the Foundation&#8217;s Hawai&#699;i Program Lead, put it: trust is not given, it is earned, through consistency, humility, and respect for <span class="term">pilina</span> <span class="gloss">(relationship)</span>. Here, change looks like a skeptical teacher becoming a champion, or a <span class="term">kumu</span> <span class="gloss">(teacher)</span> arriving on autopilot and leaving reconnected to her <span class="term">na&#699;au</span> <span class="gloss">(center)</span>. This is what happens when wellbeing is offered as relationship, not program. <span class="term">He alo a he alo</span> <span class="gloss">(face to face)</span>, until trust becomes the ground everything else grows from.</p>
      </div>
    </div>

    <div class="mag-stats anim">
      <div class="rhl-i"><div class="rnum">10</div><div class="lab">schools across 4 islands actively engaged</div></div>
      <div class="rhl-i"><div class="rnum">50</div><div class="lab">educators Level 1 or Level 2 certified</div></div>
      <div class="rhl-i"><div class="rnum">200</div><div class="lab">educators using the Contentment School Platform</div></div>
      <div class="rhl-i"><div class="rnum">100%</div><div class="lab">of fully certified educators felt their own wellbeing improve (2025)</div></div>
      <div class="rhl-i"><div class="rnum">95.5%</div><div class="lab">gained practical wellbeing tools they could use right away</div></div>
      <div class="rhl-i"><div class="rnum">100%</div><div class="lab">felt the work honored Hawaiian culture and values</div></div>
    </div>

    <div class="voices voices-interactive anim" data-voices>
      <div class="voices-lab">What educators told us</div>
      <div class="voices-people vp-2" role="tablist">
        <button class="vperson" role="tab" aria-selected="false" data-vq="haw-1">
          <span class="vp-portrait"><img src="/assets/oi-img-20.jpg" alt="Miguel K. Pa&#699;ekukui" width="360" height="360"></span>
          <span class="vp-name">Miguel K. Pa&#699;ekukui</span>
        </button>
        <button class="vperson" role="tab" aria-selected="false" data-vq="haw-2">
          <span class="vp-portrait"><img src="/assets/oi-img-21.jpg" alt="Jamie Fong" width="360" height="360"></span>
          <span class="vp-name">Jamie Fong</span>
        </button>
      </div>
      <div class="voices-panels">
        <blockquote class="vpanel" id="haw-1">The Four Pillars of Wellbeing has saved my life, personally and professionally. I can navigate the emotions and ups and downs I face, and help my students do the same, meeting fear, grief, and other feelings with success and grace.<cite><b>Miguel K. Pa&#699;ekukui</b><span>Dean of Personalized Learning, Saint Louis School, Honolulu, Hawai&#699;i</span></cite></blockquote>
        <blockquote class="vpanel" id="haw-2">Connecting with other educators has been amazing. When we build <span class="term">pilina</span> <span class="gloss">(relationships)</span> and show gratitude, the students see it. To serve our students fully, our cup needs to be full. Educator wellbeing is paramount in school settings.<cite><b>Jamie Fong</b><span>Counselor / Director of Student Success, Saint Louis School, Honolulu, Hawai&#699;i</span></cite></blockquote>
      </div>
    </div>

  </div>
</section>

<!-- ============ REGION: MAINLAND NORTH AMERICA ============ -->
<section class="region region-mag region-flip-mag" id="mainland">
  <div class="wrap">
    <div class="region-photo anim"><img src="/assets/oi-img-22.jpg" alt="Educators in North America" width="1500" height="643"></div>

    <div class="mag-intro anim">
      <h2 class="region-header">North America</h2>
    </div>

    <div class="mag-lead anim">
      <div class="mag-lead-vid">
        <button class="vfeat" data-yt="eZXBmoe-RZk" aria-label="Play video: Corbett Preparatory School, Tampa">
          <span class="vposter" style="background-image:url('/assets/oi-img-23.jpg')"></span>
          <span class="vscrim"></span><span class="vplay"></span>
        </button>
        <span class="vlabel">Corbett Preparatory School<i>Tampa, FL &middot; the first pilot school &middot; video story</i></span>
      </div>
      <div class="mag-lead-text">
        <p><strong class="lede-open">In 2016, Corbett Preparatory School in Tampa became the first school in the world to say yes.</strong> Then Covid hit, and a digital platform carried the work to New York City schools through one of the hardest seasons educators had faced.</p>
        <p>From there it traveled person to person, to Siskiyou County in California, to Lakeland in Florida, and beyond. A Corbett educator carried it with him to The Country School in California, as something he had lived, not a program in a binder. The Four Pillars of Wellbeing spread because educators who felt something real wanted others to feel it too.</p>
      </div>
    </div>

    <div class="mag-stats anim">
      <div class="rhl-i"><div class="rnum">31</div><div class="lab">schools &amp; partner organizations</div></div>
      <div class="rhl-i"><div class="rnum">5</div><div class="lab">states &amp; provinces, Florida to California to Ontario</div></div>
      <div class="rhl-i"><div class="rnum">698</div><div class="lab">educators on the Contentment School Platform</div></div>
      <div class="rhl-i"><div class="rnum">94.1%</div><div class="lab">felt their own wellbeing improve (2025)</div></div>
      <div class="rhl-i"><div class="rnum">76.4%</div><div class="lab">felt more confident bringing the Four Pillars into their classroom</div></div>
      <div class="rhl-i"><div class="rnum">100%</div><div class="lab">left excited to bring the Four Pillars to their school</div></div>
    </div>

    <div class="voices voices-interactive anim" data-voices>
      <div class="voices-lab">What educators told us</div>
      <div class="voices-people" role="tablist">
        <button class="vperson" role="tab" aria-selected="false" data-vq="na-1">
          <span class="vp-portrait"><img src="/assets/oi-img-24.jpg" alt="Rachele Lalonde" width="400" height="400"></span>
          <span class="vp-name">Rachele Lalonde</span>
        </button>
        <button class="vperson" role="tab" aria-selected="false" data-vq="na-2">
          <span class="vp-portrait"><img src="/assets/oi-img-25.jpg" alt="Ginger Lee Charles" width="400" height="400"></span>
          <span class="vp-name">Ginger Lee Charles</span>
        </button>
        <button class="vperson" role="tab" aria-selected="false" data-vq="na-3">
          <span class="vp-portrait"><img src="/assets/oi-img-26.jpg" alt="Matt Melnick" width="400" height="400"></span>
          <span class="vp-name">Matt Melnick</span>
        </button>
      </div>
      <div class="voices-panels">
        <blockquote class="vpanel" id="na-1">The Four Pillars has reached every part of who I am, as a person, a mother, a teacher, a friend. It gave me something I didn&#8217;t realize I was missing: the pause, the grace, the ability to meet my life with presence instead of exhaustion. In my classroom, I see the transformation every day.<cite><b>Rachele Lalonde</b><span>Williamstown Public School, Ontario, Canada</span></cite></blockquote>
        <blockquote class="vpanel" id="na-2">Staff say it&#8217;s one of the best trainings of their entire career. When someone says this has profoundly changed me as a human being, that&#8217;s huge. These are skills they&#8217;ll carry for the rest of their lives. It&#8217;s one of the best things you can do for your students and your staff.<cite><b>Ginger Lee Charles</b><span>Superintendent / Principal, Grenada Elementary, Siskiyou County, California</span></cite></blockquote>
        <blockquote class="vpanel" id="na-3">The Four Pillars have allowed me to slow down in meaningful ways. It&#8217;s helped me trust myself more fully and truly listen to what others reflect back to me. My relationships have deepened, grounded in greater presence and authenticity.<cite><b>Matt Melnick</b><span>Assistant Head of Academics &amp; Wellness, The Country School, Los Angeles, California</span></cite></blockquote>
      </div>
    </div>

    <div class="mag-more anim">
      <div class="voices-lab">More from these schools</div>
      <div class="vrow mag-vrow">
        <button class="vthumb" data-yt="aUuF_xx-opA" aria-label="Play video: P.S./M.S. 124, Queens">
          <span class="vposter" style="background-image:url('/assets/oi-img-27.jpg')"></span>
          <span class="vscrim"></span><span class="vplay"></span>
          <span class="vt-cap">P.S./M.S. 124 &middot; Queens, NY</span>
        </button>
        <button class="vthumb" data-yt="j1qMIFUHoFU" aria-label="Play video: Grenada Elementary, Siskiyou County">
          <span class="vposter" style="background-image:url('/assets/oi-img-28.jpg')"></span>
          <span class="vscrim"></span><span class="vplay"></span>
          <span class="vt-cap">Grenada Elementary &middot; Siskiyou County, CA</span>
        </button>
        <button class="vthumb" data-yt="EPbg8bD1A4M" aria-label="Play video: Excel Christian Academy, Lakeland">
          <span class="vposter" style="background-image:url('/assets/oi-img-29.jpg')"></span>
          <span class="vscrim"></span><span class="vplay"></span>
          <span class="vt-cap">Excel Christian Academy &middot; Lakeland, FL</span>
        </button>
      </div>
    </div>
  </div>
</section>


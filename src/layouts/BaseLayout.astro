---
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import Analytics from '../components/Analytics.astro';
import KeelaScripts from '../components/KeelaScripts.astro';
import '../styles/tokens.css';
import '../styles/global.css';

interface Props {
  title: string;
  description?: string;
  ogImage?: string;
  ogType?: string;
  /**
   * Load the Keela Forms master script + stylesheet. OPT-IN: it was previously loaded on
   * every route, but only 3 of 10 mount an embed, so the other 7 paid a render-blocking
   * third-party stylesheet for nothing (PRE-LAUNCH-QA-AUDIT perf work).
   *
   * SET THIS TO TRUE on any page that renders <KeelaDonateForm /> — directly or through a
   * component like <HomeroomBlock />. Without it the embed mounts unstyled and never
   * initialises, because window.Keela is undefined.
   */
  keela?: boolean;
}

const {
  title,
  description = 'The Contentment Foundation — teacher and student wellbeing.',
  ogImage = '/assets/logo_lockup_light.svg',
  ogType = 'website',
  keela = false,
} = Astro.props;

// `build.format: 'file'` (6 Aug) makes pathname `/why.html`, so canonical and og:url
// would advertise a .html URL that neither the sitemap nor any link uses. Strip it.
// `/index.html` -> `/` first, so the homepage canonical stays the bare origin.
const cleanPath = Astro.url.pathname.replace(/index\.html$/, '').replace(/\.html$/, '') || '/';
const canonicalURL = new URL(cleanPath, Astro.site);
---
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{title}</title>
  <meta name="description" content={description}>
  <link rel="canonical" href={canonicalURL}>

  <!-- Open Graph / Social Media -->
  <meta property="og:type" content={ogType}>
  <meta property="og:url" content={canonicalURL}>
  <meta property="og:title" content={title}>
  <meta property="og:description" content={description}>
  <meta property="og:image" content={new URL(ogImage, Astro.site)}>

  <!-- Twitter / X Card -->
  <meta name="twitter:card" content="summary_large_image">
  <meta name="twitter:url" content={canonicalURL}>
  <meta name="twitter:title" content={title}>
  <meta name="twitter:description" content={description}>
  <meta name="twitter:image" content={new URL(ogImage, Astro.site)}>

  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  {/* PRE-LAUNCH-QA-AUDIT: this stylesheet was render-blocking on every route. `display=swap`
      was already set, but that governs how the FONT behaves once the CSS arrives — it does
      nothing about the round-trip to fonts.googleapis.com that blocks first paint.
      Loaded async via the media="print" swap: the browser fetches it at low priority and
      does not block rendering, then onload flips it to `all` and it applies. The <noscript>
      copy keeps fonts working with JS disabled. */}
  <link
    rel="stylesheet"
    href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Inter:wght@400;500;600;700&family=Varela+Round&family=Cedarville+Cursive&display=swap"
    media="print"
    onload="this.media='all';this.onload=null"
  >
  <noscript>
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Newsreader:ital,opsz,wght@0,6..72,400;0,6..72,500;0,6..72,600;1,6..72,400;1,6..72,500&family=Inter:wght@400;500;600;700&family=Varela+Round&family=Cedarville+Cursive&display=swap">
  </noscript>
  <link rel="icon" type="image/svg+xml" href="/favicon.svg">
  <Analytics />
  {keela && <KeelaScripts />}
  <slot name="head" />
</head>
<body>
  {/* PRE-LAUNCH-QA-AUDIT.md Critical: no main landmark and no skip link on any route.
      It repeated on all of them because the fix belongs here, not on the pages —
      screen-reader users had no way to jump past the nav, and keyboard users had to
      tab the whole header on every navigation. JSX comment, so it does not ship. */}
  <a class="skip-link" href="#main">Skip to main content</a>
  <Nav />
  <main id="main" tabindex="-1">
    <slot />
  </main>
  <Footer />
  <script>
    import { initNav } from '../scripts/nav.js';
    import { initHeroEntrance, initRevealOnScroll, initCountUp, initParallax } from '../scripts/animations.js';

    initNav();
    initHeroEntrance();
    initRevealOnScroll();
    initCountUp();
    initParallax();
  </script>
</body>
</html>

---
/**
 * Homeroom band — homepage.
 * Keela General Donation Form embed (seams.keela.generalDonationForm).
 * India region + per-tier Homeroom checkout URLs deferred.
 */
import KeelaDonateForm from './KeelaDonateForm.astro';
---
<section class="band homeroom" id="homeroom">
  <div class="hr-card">
    <img class="anim" src="/assets/priscillah_card.webp" alt="Priscillah Njuguna, Educator at OLC Mugoiri Girls High School in Kenya: You didn't just fund a program. You changed a teacher. You uplifted a staff. You healed a school. And for that, I will remain grateful for the rest of my life." width="1600" height="1747">
  </div>
  <div class="hr-ask">
    <div class="eyebrow anim">Take your seat</div>
    <h2 class="anim d1">Pull up a seat and join us.</h2>
    <p class="lead anim d2">Homeroom is our community of monthly supporters. You fund the training and coaching that make change like Priscillah's possible, and you get a front-row seat to it.</p>

    <div class="hr-widget anim d3">
      <KeelaDonateForm source="homepage_homeroom_block" />
    </div>

    <p class="hr-note anim d4">The Contentment Foundation is a 501(c)(3) nonprofit (EIN 47-5432756). Contributions are tax-deductible to the extent permitted by law.</p>
  </div>
</section>

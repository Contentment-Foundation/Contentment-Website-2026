---
import { seams } from '../config/seams';
const joinHref = seams.join || '/give';
const joinAttrs = /^https?:\/\//.test(joinHref)
  ? { target: '_blank', rel: 'noopener' }
  : {};
---
<section class="invite">
  <div class="invite-bg"></div>
  <div class="wrap invite-inner">
    <p class="intro anim">You just met our partner school in Kenya. Here's how classrooms like theirs stay supported throughout the year.</p>
    <h2 class="anim d1">Reach one teacher. Reach every kid they'll ever teach.</h2>
    <p class="sub anim d2">Homeroom is a monthly gift starting at $25, a teacher who gets a whole year of support, and hundreds of kids who feel the difference.</p>
    <a href={joinHref} class="btn btn-primary anim d3" {...joinAttrs}>Join Homeroom, from $25/month <span class="arrow">→</span></a>
  </div>
</section>

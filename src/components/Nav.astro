---
import { seams } from '../config/seams';

const navLinks = [
  { href: '/about', label: 'About' },
  { href: '/why', label: 'Why Teacher Wellbeing' },
  { href: '/our-impact', label: 'Our Impact' },
  { href: '/schools', label: 'Schools' },
  { href: '/events', label: 'Events' },
  { href: '/getinvolved', label: 'Get Involved' },
];

const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => {
  const path = href.replace(/\/$/, '') || '/';
  return pathname === path || (path !== '/' && pathname.startsWith(`${path}/`));
};

const homeroomHref = seams.join || '/getinvolved';
const donateHref = seams.donate || '/getinvolved#become';
const signInHref = seams.schoolPlatform || '#';
const newTab = { target: '_blank', rel: 'noopener' } as const;
const externalAttrs = (href: string) =>
  /^https?:\/\//.test(href) ? newTab : {};
---
<header id="hdr">
  <div class="wrap nav">
    <!-- FEAT-002 — `/` is not in navLinks (it has no header nav item by design), so the
         brand lockup is the only site-chrome link to the homepage and therefore the element
         that must carry aria-current there. Verified: no `.brand[aria-current]` rule exists
         in global.css, so this is semantics-only and ships no visual change. -->
    <a class="brand" href="/" aria-label="The Contentment Foundation, home" aria-current={isCurrent('/') ? 'page' : undefined}>
      <img src="/assets/logo_lockup_light.svg" alt="The Contentment Foundation" class="brand-logo--light" width="300" height="84">
      <img src="/assets/logo_lockup_dark.svg" alt="" aria-hidden="true" class="brand-logo--dark" width="300" height="84">
    </a>
    <nav class="nav-links" aria-label="Main">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </nav>
    <div class="nav-right">
      <a href={signInHref} class="signin" {...externalAttrs(signInHref)}>Sign In</a>
      <a href={donateHref} class="nav-cta" {...externalAttrs(donateHref)}>Donate</a>
    </div>
    <button
      type="button"
      class="menu-btn"
      aria-label="Menu"
      aria-expanded="false"
      aria-controls="nav-drawer"
    ><span></span><span></span><span></span></button>
  </div>
</header>

<div id="nav-drawer" class="nav-drawer" aria-hidden="true">
  <div class="nav-drawer__backdrop" tabindex="-1"></div>
  <nav class="nav-drawer__panel" aria-label="Main">
    <button type="button" class="nav-drawer__close" aria-label="Close menu">
      <span aria-hidden="true"></span>
      <span aria-hidden="true"></span>
    </button>
    <div class="nav-drawer__links">
      {navLinks.map((link) => (
        <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>{link.label}</a>
      ))}
    </div>
    <div class="nav-drawer__actions">
      <a href={signInHref} class="nav-drawer__signin" {...externalAttrs(signInHref)}>Sign In</a>
      <a href={homeroomHref} class="nav-drawer__cta nav-drawer__cta--homeroom" {...externalAttrs(homeroomHref)}>Join Homeroom</a>
      <a href={donateHref} class="nav-drawer__cta nav-drawer__cta--donate" {...externalAttrs(donateHref)}>Donate</a>
    </div>
  </nav>
</div>

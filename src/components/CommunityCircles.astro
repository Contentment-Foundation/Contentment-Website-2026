---
import { seams } from '../config/seams';
---
<section class="band-tight alone">
  <div class="wrap">
    <div class="alone-head anim">
      <span class="eyebrow">You are not alone</span>
      <h2 class="title">One practice. <span class="script">A global community.</span></h2>
      <p class="lead">From a basketball court in Bhutan to a community hall in Hawaiʻi to a schoolyard in Uganda. Teachers finding their way back to themselves, together.</p>
    </div>
    <div class="circles">
      <div class="circ-wrap anim"><div class="circ"><img src="/assets/img05_7be3a8147a.jpg" alt="Teachers in a wellbeing circle on a court in Bhutan"></div></div>
      <div class="circ-wrap anim d1"><div class="circ"><img src="/assets/img06_fad9caad04.jpg" alt="Educators in a wellbeing circle in Hawai‘i"></div></div>
      <div class="circ-wrap anim d2"><div class="circ"><img src="/assets/img07_6e5f9ecefa.jpg" alt="Educators in a wellbeing circle in Uganda"></div></div>
      <div class="circ-wrap anim d3"><div class="circ"><img src="/assets/img08_8646669d20.jpg" alt="A teacher and young students in a classroom in Tampa, Florida"></div></div>
    </div>
    <a href={seams.link.instagram || '#'} class="ig-follow anim d4" target="_blank" rel="noopener"><img src="/assets/instagram.png" alt="">Follow the journey on Instagram</a>
  </div>
</section>

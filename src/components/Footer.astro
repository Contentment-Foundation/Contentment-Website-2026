---
import { seams } from '../config/seams';

const donateHref = seams.donate || '/getinvolved#become';
const getInvolvedHref = seams.join || '/getinvolved';
const newTab = { target: '_blank', rel: 'noopener' } as const;
const externalAttrs = (href: string) =>
  /^https?:\/\//.test(href) ? newTab : {};

// FEAT-002 — current-page marking, same trailing-slash-safe normalization as Nav.astro.
// Deliberately applied ONLY to routes whose sole site-chrome link lives in this footer
// (today: /updates). The six Nav.astro `navLinks` routes are already marked in the header
// and drawer; re-marking them here would announce "current page" a third time to a screen
// reader for no added orientation. Add /privacy + /terms here when FEAT-071 lands.
// The trailing-slash strip is load-bearing: Astro's directory build makes the build-time
// pathname `/updates/`, so a bare `Astro.url.pathname === href` would never match.
const pathname = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => pathname === href.replace(/\/$/, '');
---
<footer>
  <div class="wrap">
    <div class="foot-top">
      <div>
        <div class="foot-brand"><img src="/assets/logo_lockup_light.svg" alt="The Contentment Foundation" width="300" height="84"></div>
        <p class="foot-tag">When one teacher thrives, generations flourish.</p>
      </div>
      <div class="foot-col">
        <h4>Explore</h4>
        <a href="/about">About</a>
        <a href="/why">Why Teacher Wellbeing</a>
        <a href="/our-impact">Our Impact</a>
        <a href="/updates" aria-current={isCurrent('/updates') ? 'page' : undefined}>Updates</a>
        <a href="/privacy" aria-current={isCurrent('/privacy') ? 'page' : undefined}>Privacy &amp; cookies</a>
        <!-- /docs stays unmarked on purpose: it is a public/ directory index served by a
             netlify.toml rewrite, not an Astro route, so no built page's pathname equals it. -->
        <a href="/docs">Project docs</a>
      </div>
      <div class="foot-col">
        <h4>Get Involved</h4>
        <a href="/schools">Schools</a>
        <a href="/events">Events</a>
        <a href={getInvolvedHref} {...externalAttrs(getInvolvedHref)}>Get Involved</a>
        <a href={donateHref} {...externalAttrs(donateHref)}>Donate</a>
      </div>
      <div class="foot-col"><h4>Connect</h4><a href="mailto:hello@contentment.org">hello@contentment.org</a>
        <div class="foot-social">
          <a href={seams.link.linkedin || '#'} target="_blank" rel="noopener" aria-label="LinkedIn"><svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4.98 3.5a2.5 2.5 0 1 1 0 5 2.5 2.5 0 0 1 0-5zM3 9h4v12H3V9zm7 0h3.8v1.7h.05c.53-.95 1.83-1.95 3.75-1.95C21.6 8.75 22 11.2 22 14.4V21h-4v-5.9c0-1.4-.03-3.2-2-3.2-2 0-2.3 1.5-2.3 3.1V21h-4V9z"/></svg></a>

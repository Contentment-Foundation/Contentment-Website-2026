---
/**
 * Analytics.astro — TICKET-080 (Analytics setup).
 *
 * Single self-contained analytics/consent bundle: Cookiebot CMP, GA4 (gtag.js) with
 * Consent Mode v2, Microsoft Clarity, and PostHog Cloud (cookieless).
 *
 * Every piece checks its OWN env var independently and renders nothing if that
 * var is empty — same "empty string = not wired yet" philosophy as
 * src/config/seams.ts. A missing PostHog key must never disable GA4, and vice
 * versa. With every var unset (today's real state), this component renders
 * nothing at all: no script tags, no console errors.
 *
 * Tool stack + reasoning: docs/planning/DECISIONS.md DECISION-001 (tool
 * stack), DECISION-002 (CMP + GA4 Consent Mode v2 + cookieless PostHog),
 * DECISION-007 (PostHog Cloud). Env var reference: TECHNICAL-ARCHITECTURE §6.1.
 *
 * CMP vendor changed Osano -> Cookiebot on 4 Aug 2026; PUBLIC_OSANO_CUSTOMER_ID was
 * renamed to PUBLIC_COOKIEBOT_ID across code, .env.example, TECHNICAL-ARCHITECTURE
 * §6.1, DECISIONS.md and launch-plan-data.json in the same pass — deliberately all at
 * once, since partial renames are what broke FLODESK_FORM_ID (31 Jul) and
 * PUBLIC_POSTHOG_KEY (3 Aug).
 */
const GA_ID = import.meta.env.PUBLIC_GA_ID;
const COOKIEBOT_ID = import.meta.env.PUBLIC_COOKIEBOT_ID;
const POSTHOG_KEY = import.meta.env.PUBLIC_POSTHOG_KEY;
const POSTHOG_HOST = import.meta.env.PUBLIC_POSTHOG_HOST || 'https://app.posthog.com';
const CLARITY_ID = import.meta.env.PUBLIC_CLARITY_ID;
---
{COOKIEBOT_ID && (
  <!-- Cookiebot CMP — must be the FIRST script in <head> (vendor requirement), which
       holds because BaseLayout renders <Analytics /> with no script above it and this
       block is first in this file. Renders the consent banner + Privacy Trigger.

       data-blockingmode="manual", NOT "auto", per the 4 Aug decision. Auto mode
       rewrites recognised tracker <script> tags to type="text/plain" until consent,
       which would (a) risk blocking our own inline gtag('consent','default') script and
       break the Consent Mode v2 model DECISION-002 is built on, and (b) block PostHog,
       which is cookieless by design and needs no consent under DECISION-007. In manual
       mode Cookiebot renders the banner and reports consent; the gating below stays the
       single source of truth. -->
  <script
    id="Cookiebot"
    src="https://consent.cookiebot.com/uc.js"
    data-cbid={COOKIEBOT_ID}
    data-blockingmode="manual"
    type="text/javascript"
    is:inline
  ></script>
)}

{COOKIEBOT_ID && (
  <!-- Compact banner overrides. Measured on the live deploy 4 Aug 2026: the stock
       CybotMultilevel template rendered 1280x265 on desktop (33% of the viewport) and
       374x800 on mobile — 95% of a 390x844 screen, i.e. it covered the whole page.
       Height came from three places: body text 192px, buttons stacking vertically
       279px, and the branding header 57px.

       is:inline is REQUIRED, and is:global is WRONG here. Astro extracts and bundles
       <style> blocks at build time, which happens BEFORE the {COOKIEBOT_ID && ...}
       guard is evaluated — so an is:global block shipped these rules to all 9 pages
       even with every analytics var unset, breaking the "unset = zero analytics code"
       rule. is:inline opts out of Astro's style pipeline entirely, leaving the tag
       inside the conditional where it belongs. Verified 4 Aug: unset build emits none.

       Cookiebot injects its dialog outside our component tree, so these must not be
       scoped. Selectors are Cookiebot's stable public IDs, not generated classes, but
       this is still vendor markup: re-check after any template change (HC-076).

       NOT hidden: the "Powered by Cookiebot" link. Free-tier terms require that
       attribution, so it is scaled down rather than removed.

       Accessibility held: buttons keep a 44px min tap target, text stays >=0.8rem,
       and long copy scrolls inside the dialog instead of being clipped. -->
  <style is:inline>
    /* !important is unavoidable: uc.js injects Cookiebot's stylesheet AFTER this
       block, so equal-specificity rules lose the cascade. Measured 4 Aug — without
       it, max-height computed to Cookiebot's own calc(100% - 16px) and the 90x90
       logo ignored the cap entirely. */
    /* Pin to the bottom edge. Stock CybotEdge centres the dialog with
       top:422px + transform:translate(-187px,-211px), so on a phone it floats in
       the MIDDLE of the screen over the content someone is trying to read. A
       bottom bar keeps the page usable while consent is pending. */
    #CybotCookiebotDialog {
      top: auto !important;
      bottom: 0 !important;
      left: 0 !important;
      right: 0 !important;
      transform: none !important;
      margin: 0 auto !important;
      /* Cookiebot pins min-width to the viewport (measured 1280px on desktop),
         which beats max-width and kept this a full-width slab. */
      min-width: 0 !important;
      max-width: 860px !important;
      max-height: 40vh !important;
      overflow-y: auto !important;
      font-size: 0.85rem !important;
      border-radius: 10px 10px 0 0 !important;
      /* Stock padding is 24px, i.e. 48px of pure vertical chrome. */
      padding: 12px !important;
    }
    /* Collapse the four inline consent-category toggles (122px on mobile, and the
       single largest remaining block). This is NOT a loss of granular consent:
       Cookiebot renders its own "Show details" link
       (#CybotCookiebotDialogBodyEdgeMoreDetailsLink), which opens the same
       per-category controls. Accept / Reject / Customise with "Allow all" and
       "Deny" equally prominent is the standard compliant pattern — what would be
       non-compliant is burying Deny or removing the details path, and neither
       happens here. Revert this one rule if legal wants categories on first view. */
    #CybotCookiebotDialogBodyFieldsetInnerContainer { display: none !important; }
    #CybotCookiebotDialogBodyEdgeMoreDetailsLink {
      font-size: 0.78rem !important;
      text-decoration: underline !important;
    }
    /* Branding block: 208px tall on desktop, driven by a 90x90 logo. Scaled, not
       removed — free-tier terms require the attribution. */
    #CybotCookiebotDialogPoweredbyImage {
      max-height: 18px !important;
      max-width: 18px !important;
      width: auto !important;
    }
    #CybotCookiebotDialogPoweredbyCybot,
    #CybotCookiebotDialogPoweredbyLink { max-height: 20px !important; }
    #CybotCookiebotDialogHeader { padding: 0.4rem 0.6rem !important; }
    /* Desktop's real driver: this wrapper measured 191x189, which stretched the
       header column to 202px and dragged the whole flex row with it — the body
       content only needs ~157px. Capping it is what actually shrinks desktop. */
    #CybotCookiebotDialogHeaderLogosWrapper {
      max-height: 28px !important;
      height: auto !important;
    }
    #CybotCookiebotDialogBodyContentTitle {
      font-size: 0.95rem !important;
      margin-bottom: 0.25rem !important;
    }
    /* Cap the copy and scroll it rather than let it push the dialog open. */
    #CybotCookiebotDialogBodyContentText {
      font-size: 0.8rem !important;
      line-height: 1.45 !important;
      max-height: 5.5em !important;
      overflow-y: auto !important;
    }
    #CybotCookiebotDialogBodyContent { padding: 0.4rem 0.9rem !important; }
    /* Last of the fat: TabContent measured 190px on desktop wrapping a 118px
       BodyContent, and 157 vs 94 on mobile — ~70px and ~63px of vertical padding
       and a 60px min-height. Horizontal margin is preserved (it separates the body
       from the branding column); only the vertical slack goes. */
    #CybotCookiebotDialogTabContent,
    #CybotCookiebotDialogBody {
      min-height: 0 !important;
      padding-top: 0 !important;
      padding-bottom: 0 !important;
      margin-top: 0 !important;
      margin-bottom: 0 !important;
    }
    #CybotCookiebotDialogBodyButtonDecline,
    #CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll,
    #CybotCookiebotDialogBodyLevelButtonLevelOptinAllowallSelection,
    #CybotCookiebotDialogBodyButtonAccept {
      min-height: 44px !important;
      padding: 0.5rem 0.9rem !important;
      font-size: 0.82rem !important;
    }
    /* "Allow all" and "Deny" were 44px each stacked = 88px. Side by side costs one
       row and keeps both equally prominent, which is the fairness requirement.
       They live in #CybotCookiebotDialogBodyButtons (flex column / column-reverse),
       NOT in BodyLevelButtonsTable — targeting the latter did nothing. */
    #CybotCookiebotDialogBodyButtons,
    #CybotCookiebotDialogBodyButtonsWrapper {
      flex-direction: row !important;
      flex-wrap: wrap !important;
      gap: 0.4rem !important;
      align-items: center !important;
      width: 100% !important;
    }
    #CybotCookiebotDialogBodyLevelButtonLevelOptinAllowAll,
    #CybotCookiebotDialogBodyButtonDecline {
      flex: 1 1 0 !important;
      width: auto !important;
      min-width: 110px !important;
      margin: 0 !important;
    }
    /* Fader/scroll chrome adds ~64px of empty gradient we do not need at this size. */
    #CybotCookiebotFader { display: none !important; }
    @media (max-width: 600px) {
      #CybotCookiebotDialog {
        max-height: 34vh !important;
        border-radius: 12px 12px 0 0 !important;
      }
      #CybotCookiebotDialogBodyContentText { max-height: 3.6em !important; }
    }
  </style>
)}

{GA_ID && (
  <>
    <!-- GA4 Consent Mode v2 — default to denied/cookieless until Osano reports consent. -->
    <script is:inline define:vars={{ GA_ID }}>
      window.dataLayer = window.dataLayer || [];
      function gtag() { window.dataLayer.push(arguments); }
      window.gtag = gtag;

      gtag('consent', 'default', {
        // The four Consent Mode v2 REQUIRED signals.
        ad_storage: 'denied',
        ad_user_data: 'denied',
        ad_personalization: 'denied',
        analytics_storage: 'denied',
        // Optional signals. Not required by v2, but leaving them unspecified means
        // "unset" rather than "denied" — stating them makes the pre-consent posture
        // explicit. security_storage is granted because it covers fraud prevention
        // and authentication, which are strictly necessary and need no consent.
        functionality_storage: 'denied',
        personalization_storage: 'denied',
        security_storage: 'granted',
        wait_for_update: 500,
      });

      // While ad_storage is denied, redact ad click identifiers from Google network
      // requests. No effect once ad_storage is granted, so it is safe to leave on.
      gtag('set', 'ads_data_redaction', true);
      // Do not append consent state to outbound URLs. This is Google's default; set
      // explicitly so a future GTM container cannot silently flip it on.
      gtag('set', 'url_passthrough', false);

      gtag('js', new Date());
      gtag('config', GA_ID, { anonymize_ip: true });
    </script>
    <script async src={`https://www.googletagmanager.com/gtag/js?id=${GA_ID}`}></script>
  </>
)}

{CLARITY_ID && (
  <!-- Microsoft Clarity — heatmaps + session recordings (DECISION-001). Consent Mode
       default-denied below, upgraded by the Osano bridge, same as GA4. -->
  <script is:inline define:vars={{ CLARITY_ID }}>
    (function (c, l, a, r, i, t, y) {
      c[a] = c[a] || function () { (c[a].q = c[a].q || []).push(arguments); };
      t = l.createElement(r);
      t.async = 1;
      t.src = 'https://www.clarity.ms/tag/' + i;
      y = l.getElementsByTagName(r)[0];
      y.parentNode.insertBefore(t, y);
    })(window, document, 'clarity', 'script', CLARITY_ID);

    // Consent Mode default — DENIED until a CMP says otherwise, mirroring the
    // gtag('consent', 'default', ...) call in the GA4 block. Queued on Clarity's own
    // stub, so it applies whether or not clarity.js has finished loading.
    //
    // Clarity's Consent Mode is ALREADY on by default for EEA/UK/CH visitors, and
    // enforced for them since 31 Oct 2025 — but it is NOT on elsewhere unless the
    // project's Settings -> Setup cookie toggle is turned off. This call is what makes
    // the posture uniform for every visitor instead of European ones only. Note the
    // capitalised keys: Clarity uses ad_Storage/analytics_Storage, GA4 uses lowercase.
    //
    // Denied does not stop Clarity collecting — it drops the _clck/_clsk cookies, so
    // sessions fragment to one ID per page view and replays/heatmaps/funnels are
    // limited. Whether cookieless session capture is acceptable without a banner is a
    // legal call for the team, not a code one (see TRACKER 3 Aug / DECISION-002).
    window.clarity('consentv2', { ad_Storage: 'denied', analytics_Storage: 'denied' });
  </script>
)}

{COOKIEBOT_ID && (
  <script is:inline>
    // Cookiebot -> Consent Mode bridge, driving BOTH GA4 and Clarity off one banner.
    // Gated on the CMP rather than on GA4: this listener used to live inside the GA4
    // block, which meant that with GA4 unset there was no path to upgrade Clarity off
    // denied at all. Each tool is updated only if it actually loaded, so either can be
    // switched off independently.
    //
    // Cookiebot exposes consent as booleans on window.Cookiebot.consent
    // (necessary / preferences / statistics / marketing) rather than Osano's
    // event.detail string enum. Category mapping: statistics -> analytics_storage,
    // marketing -> the three ad_* signals.
    //
    // Three events, all needed: OnConsentReady fires on every page load for a visitor
    // who already chose (the common case — without it a returning visitor stays denied
    // for the whole session), while OnAccept/OnDecline fire on a fresh interaction.
    //
    // NOTE: Cookiebot's own "Google Consent Mode" feature must stay DISABLED in the
    // dashboard. It emits its own gtag('consent','default'/'update') calls, which would
    // race the ones in this file and silently override whichever loses.
    function applyCookiebotConsent() {
      const consent = (window.Cookiebot && window.Cookiebot.consent) || {};
      const analyticsGranted = consent.statistics ? 'granted' : 'denied';
      const marketingGranted = consent.marketing ? 'granted' : 'denied';
      // Cookiebot's "preferences" category is the one that maps onto Google's
      // functionality_storage + personalization_storage. Without this, those two
      // stayed pinned at their denied default even after the visitor accepted.
      const preferencesGranted = consent.preferences ? 'granted' : 'denied';

      if (typeof window.gtag === 'function') {
        window.gtag('consent', 'update', {
          analytics_storage: analyticsGranted,
          ad_storage: marketingGranted,
          ad_user_data: marketingGranted,
          ad_personalization: marketingGranted,
          functionality_storage: preferencesGranted,
          personalization_storage: preferencesGranted,
        });
      }

      if (typeof window.clarity === 'function') {
        window.clarity('consentv2', {
          analytics_Storage: analyticsGranted,
          ad_Storage: marketingGranted,
        });
      }
    }

    window.addEventListener('CookiebotOnConsentReady', applyCookiebotConsent);
    window.addEventListener('CookiebotOnAccept', applyCookiebotConsent);
    window.addEventListener('CookiebotOnDecline', applyCookiebotConsent);

    // Defensive: uc.js is deliberately the FIRST script in <head>, so for a returning
    // visitor with cached consent Cookiebot can resolve and dispatch OnConsentReady
    // while uc.js is still executing — before the listeners above exist. That visitor
    // would then sit at default-denied for the whole page despite having accepted.
    // Applying current state once on init closes that race; it is idempotent, since
    // re-sending the same consent values is a no-op for both gtag and clarity.
    // NOT verified locally: Cookiebot fires no events on an unregistered domain, so
    // this path needs a check on the real deploy (see HC-076).
    if (window.Cookiebot && window.Cookiebot.consent && window.Cookiebot.consent.method) {
      applyCookiebotConsent();
    }
  </script>
)}

{POSTHOG_KEY && (
  <!-- PostHog Cloud — product analytics/funnels. Cookieless: persistence: 'memory'
       is REQUIRED per DECISION-002/DECISION-007 (no PostHog cookies, no banner). -->
  <script is:inline define:vars={{ POSTHOG_KEY, POSTHOG_HOST }}>
    // Loader stub must match PostHog's official shape: array.js replays queued
    // init calls from `posthog._i` and skips setup entirely unless `__SV` is set.
    // A stub missing those two is silently ignored, and the library falls back to
    // its DEFAULT localStorage+cookie persistence — which would break the
    // cookieless guarantee in DECISION-002/007. Verified 3 Aug (HC-076): with the
    // previous stub, config.persistence read "localStorage+cookie" at runtime.
    (function (doc, ph) {
      if (ph.__SV) return;
      window.posthog = ph;
      ph._i = [];
      ph.init = function (token, config, name) {
        function stub(target, method) {
          var parts = method.split('.');
          if (parts.length === 2) { target = target[parts[0]]; method = parts[1]; }
          target[method] = function () {
            target.push([method].concat(Array.prototype.slice.call(arguments, 0)));
          };
        }
        var script = doc.createElement('script');
        script.type = 'text/javascript';
        script.crossOrigin = 'anonymous';
        script.async = true;
        script.src = config.api_host.replace('.i.posthog.com', '-assets.i.posthog.com') + '/static/array.js';
        var first = doc.getElementsByTagName('script')[0];
        first.parentNode.insertBefore(script, first);

        var target = ph;
        if (name !== undefined) { target = ph[name] = []; } else { name = 'posthog'; }
        target.people = target.people || [];
        target.toString = function (short) {
          var s = 'posthog';
          if (name !== 'posthog') s += '.' + name;
          if (!short) s += ' (stub)';
          return s;
        };
        target.people.toString = function () { return target.toString(1) + '.people (stub)'; };
        var methods = ('init capture register register_once register_for_session unregister ' +
          'unregister_for_session getFeatureFlag getFeatureFlagPayload isFeatureEnabled ' +
          'reloadFeatureFlags updateEarlyAccessFeatureEnrollment getEarlyAccessFeatures on ' +
          'onFeatureFlags onSessionId getSurveys getActiveMatchingSurveys renderSurvey ' +
          'canRenderSurvey identify setPersonProperties group resetGroups ' +
          'setPersonPropertiesForFlags resetPersonPropertiesForFlags ' +
          'setGroupPropertiesForFlags resetGroupPropertiesForFlags reset get_distinct_id ' +
          'getGroups get_session_id get_session_replay_url alias set_config ' +
          'startSessionRecording stopSessionRecording sessionRecordingStarted ' +
          'captureException loadToolbar get_property getSessionProperty ' +
          'createPersonProfile opt_in_capturing opt_out_capturing has_opted_in_capturing ' +
          'has_opted_out_capturing clear_opt_in_out_capturing debug').split(' ');
        for (var i = 0; i < methods.length; i++) stub(target, methods[i]);
        ph._i.push([token, config, name]);
      };
      ph.__SV = 1;
    })(document, window.posthog || []);

    window.posthog.init(POSTHOG_KEY, {
      api_host: POSTHOG_HOST,
      persistence: 'memory',
      autocapture: false,
    });
  </script>
)}

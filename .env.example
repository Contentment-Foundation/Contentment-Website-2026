# contentment.org — environment variable reference (key names only, no values).
# Canonical source: docs/planning/TECHNICAL-ARCHITECTURE.md §6 (Environment variables).
# Real values live in Vercel project → Settings → Environment Variables (production +
# preview). During the Netlify interim, only PUBLIC_* vars are relevant.
#
# Every var below is safe to leave unset locally — consumers treat '' the same way
# src/config/seams.ts does: "not wired yet", falls back to a safe no-op default.

# ---------------------------------------------------------------------------
# §6.1 — Public (browser-safe, PUBLIC_ prefix)
# ---------------------------------------------------------------------------
PUBLIC_SITE_URL=
PUBLIC_KEELA_TIER_5_URL=
PUBLIC_KEELA_TIER_25_URL=
PUBLIC_KEELA_TIER_100_URL=
PUBLIC_GA_ID=
PUBLIC_OSANO_CUSTOMER_ID=
PUBLIC_POSTHOG_PROJECT_TOKEN=your_posthog_project_token_here
PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
PUBLIC_CLARITY_ID=
PUBLIC_RAISELY_CAMPAIGN_URL=

# ---------------------------------------------------------------------------
# §6.2 — Core integrations (server-only)
# ---------------------------------------------------------------------------
FLODESK_API_KEY=
FLODESK_FORM_ID=

# ---------------------------------------------------------------------------
# §6.3 — Rate limiting: Upstash (server-only)
# ---------------------------------------------------------------------------
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# ---------------------------------------------------------------------------
# §6.4 — Transactional email: SendGrid (server-only)
# ---------------------------------------------------------------------------
SENDGRID_API_KEY=

# ---------------------------------------------------------------------------
# §6.5 — Slack webhooks (server-only)
# ---------------------------------------------------------------------------
SLACK_WEBHOOK_PARTNERSHIPS=
SLACK_WEBHOOK_HOMEROOM=
SLACK_WEBHOOK_GROWTH=
SLACK_WEBHOOK_EVENTS=
SLACK_WEBHOOK_CONTENT=
SLACK_WEBHOOK_ERRORS=
SLACK_WEBHOOK_METRICS=

# ---------------------------------------------------------------------------
# §6.6 — Zoom: event registration (server-only, Phase 1.5)
# ---------------------------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_FESTIVAL_WEBINAR_ID=

# ---------------------------------------------------------------------------
# §6.7 — Keela webhooks (server-only)
# ---------------------------------------------------------------------------
KEELA_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# §6.8 — Google Workspace (server-only)
# ---------------------------------------------------------------------------
GCP_SERVICE_ACCOUNT_JSON=
GOOGLE_SCHOOL_SHEET_ID=
GOOGLE_RSVP_SHEET_ID=
GOOGLE_METRICS_SHEET_ID=
GOOGLE_CALENDAR_ID=

# ---------------------------------------------------------------------------
# §6.9 — Homeroom gate & database (Phase 2+), error monitoring (Phase 1)
# ---------------------------------------------------------------------------
HOMEROOM_GATE_PASSWORD=
GCP_CLOUD_SQL_CONNECTION=
SENTRY_DSN=

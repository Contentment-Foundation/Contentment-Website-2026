.DS_Store

# Claude Code agent worktrees (scratch, not project content)
.claude/worktrees/

# Astro (TICKET-002 multi-page migration)
node_modules/
dist/
.astro/

# Netlify build copies docs/*.html here — source of truth is docs/
site/docs/
public/docs/

# Python bytecode cache (scripts/tracker-app/python)
__pycache__/
*.pyc

# Local virtualenv
.venv/

# Local Netlify folder
.netlify

# Written by `netlify dev` when it sets up the Edge Functions environment.
# Local tooling artifact, not project content — we ship no edge functions.
deno.lock

# Secrets — real credential values (GA4/PostHog/Clarity/Osano/Sentry, Flodesk,
# Keela, Slack webhooks…). Only .env.example, which holds key names and no
# values, is tracked. Never commit a populated .env.
.env
.env.*
!.env.example
